      price: '$105 USD',
      monthly: '$32 USD/mes',
      category: 'IA',
      description: "La solución definitiva con API oficial de WhatsApp Cloud, Meta Verified y multiagente.",
      delivery: "Configuración en 10 días",
      badge: "API OFICIAL",
      features: [
        'Configuración completa del Agente IA',
        'Integración con WhatsApp Business API',
        'Entrenamiento con información de tu empresa',
        'Automatización de respuestas 24/7',
        'Pruebas y puesta en marcha',
        'Soporte técnico continuo',
        'Ajustes y optimización del agente',
        'Meta Verified Business Standard',
        'Protección contra suplantación de identidad',
        'Hasta 4 dispositivos conectados',
        'Canal de difusión oficial',
        'Monitoreo y mantenimiento preventivo'
      ]
    },
    {
      id: 'landing-portal-corporativo',
      title: 'Landing + Portal Corporativo',
      subtitle: 'Portal Corporativo / Institucional',
      price: '$84 USD',
      monthly: null,
      category: 'Web',
      description: "Sitio web corporativo de alto estándar para posicionar tu marca y captar leads calificados.",
      delivery: "Entrega en 10 días",
      badge: "B2B RECOMENDADO",
      features: [
        'Landing + 6 páginas internas',
