        'Pasarelas de pago Webpay Plus y Mercado Pago',
        'Carrito de compras y cálculo de envíos',
        'Panel de administración de inventario',
        'Soporte técnico por 30 días'
      ]
    },
    {
      id: 'ecommerce-profesional',
