  ];

  return services.map(service => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} — ${service.subtitle} | Vision Code`} description={`${service.title} ${service.subtitle}. ${service.price}${service.monthly ? ` + ${service.monthly}` : ''}. Soluciones digitales profesionales de Vision Code.`}>
  <Navbar />
  
  <div class="fixed inset-0 z-0 opacity-20 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.06),transparent_70%)]"></div>
  </div>

  <main class="min-h-screen pt-32 pb-20 relative z-10 flex items-center bg-[#000000] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 w-full">
      
      <div class="mb-10">
        <a href="/tienda" class="inline-flex items-center gap-2 text-neutral-400 hover:text-white text-xs font-bold tracking-widest uppercase transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Volver a la Tienda
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- Left: Redesigned Card -->
        <div class="fade-up flex justify-center w-full">
          <div 
            class={`w-full max-w-[400px] relative flex flex-col justify-between p-8 min-h-[580px] bg-[#000000] text-white border rounded-3xl ${service.isRecommended ? 'border-white/40 shadow-[0_0_30px_rgba(255,255,255,0.12)] scale-[1.02] md:scale-[1.03] z-10' : 'border-white/10'} hover:border-white/50 hover:shadow-[0_0_30px_rgba(255,255,255,0.08)] transition-all duration-300`}
          >
            <div>
              {/* Badge/Tag */}
              <div class="min-h-[28px] mb-4">
                {service.badge && (
                  <span class={`inline-block text-[0.62rem] font-black tracking-widest uppercase px-3 py-1 rounded-full ${service.isRecommended ? 'bg-white text-black font-extrabold' : 'bg-white/10 text-white/80 border border-white/10'}`}>
                    {service.badge}
                  </span>
                )}
              </div>

              {/* Title & Description */}
              <h3 class="text-2xl font-bold tracking-tight text-white mb-2">{service.title}</h3>
              <p class="text-xs text-neutral-400 leading-relaxed mb-6 font-light">{service.description}</p>

              {/* Price & Delivery */}
              <div class="mb-6 pb-6 border-b border-white/10">
                {service.originalPrice && (
                  <div class="flex items-center gap-2 mb-1.5">
                    <span class="text-xs text-white/40 line-through font-bold">
                      {service.originalPrice}
                    </span>
                    <span class="px-2 py-0.5 rounded-full bg-lime text-black text-[9px] font-black tracking-wider uppercase">
                      {service.discount || "50% OFF"}
                    </span>
                  </div>
                )}
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-4xl font-black tracking-tight text-white">{service.price}</span>
                  {service.monthly && <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider">{service.monthly}</span>}
                </div>
                {service.delivery && (
                  <div class="text-[0.65rem] text-neutral-300 font-semibold tracking-wider uppercase mt-2">
                    {service.delivery}
                  </div>
                )}
              </div>

              {/* Features List */}
              <ul class="space-y-3 mb-8">
                {service.features.slice(0, 7).map((feature) => {
                  if (feature === '---' || feature.startsWith('+') || feature.startsWith('Todo lo del')) return null;
                  return (
                    <li class="flex items-start gap-2.5 text-xs text-neutral-300 font-light">
                      <svg class="shrink-0 w-3.5 h-3.5 mt-0.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  );
                })}
              </ul>
            </div>

            {/* CTA Button */}
            <div class="space-y-2 mt-auto">
              <a 
                href={`https://api.whatsapp.com/send?phone=56929645522&text=Hola,%20me%20gustaría%20cotizar%20el%20servicio:%20${encodeURIComponent(service.title)}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class={`w-full py-3.5 text-center text-xs font-black uppercase tracking-wider block rounded-xl transition-all ${service.isRecommended ? 'bg-white text-black hover:bg-neutral-200 shadow-[0_0_20px_rgba(255,255,255,0.2)]' : 'bg-transparent text-white border border-white/20 hover:border-white hover:bg-white/10'}`}
              >
                Cotizar Ahora ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="flex flex-col fade-up" style="transition-delay: 0.2s">
          <div class="mb-8">
            <span class="saas-badge mb-4 inline-block">{service.category}</span>
            <h1 class="text-4xl md:text-5xl font-black tracking-tight text-white mb-2 leading-tight">
              {service.title}
            </h1>
            <p class="text-xl text-neutral-400 font-light">{service.subtitle}</p>
          </div>

          <div class="mb-10 p-6 border border-white/15 rounded-2xl bg-white/5 backdrop-blur-md">
            {service.originalPrice && (
              <div class="flex items-center gap-2 mb-2">
                <span class="text-sm text-white/40 line-through font-bold">
                  {service.originalPrice}
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-lime text-black text-[10px] font-black tracking-wider uppercase">
                  {service.discount || "50% OFF"}
                </span>
              </div>
            )}
            <div class="text-3xl font-mono text-white mb-1 font-bold">{service.price}</div>
            {service.monthly && <div class="text-sm font-bold text-neutral-300 uppercase tracking-widest">+ {service.monthly}</div>}
            {!service.monthly && <div class="text-sm font-bold text-neutral-400 uppercase tracking-widest">Pago Único</div>}
          </div>

          <h3 class="text-lg font-bold text-white mb-6 tracking-wide uppercase">Características del Plan</h3>
          <ul class="space-y-4 mb-10">
            {service.features.map(feature => {
              if (feature === '---' || feature.startsWith('+') || feature.startsWith('Todo lo del')) {
                return <li class="text-white font-extrabold text-sm uppercase tracking-widest mt-6 mb-2 border-b border-white/15 pb-2">{feature.replace('---', '')}</li>
              }
              return (
                <li class="flex items-start gap-3 text-neutral-300 font-light">
                  <svg class="shrink-0 mt-1 text-white" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {feature}
                </li>
              )
            })}
          </ul>

          <div class="space-y-3">
            <button
              type="button"
              data-flow-trigger
              data-subject={`Vision Code - ${service.title}`}
              data-amount={service.price.replace(/[^0-9]/g, '')}
              data-plan={service.id}
              class="w-full py-4 text-xs font-black uppercase tracking-widest rounded-full bg-lime text-black hover:bg-lime/90 transition-all flex items-center justify-center gap-2 shadow-[0_0_25px_rgba(184,221,46,0.35)] hover:scale-[1.01] cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <span>Contratar Servicio</span>
            </button>

            <a href={`https://api.whatsapp.com/send?phone=56929645522&text=Hola,%20me%20interesa%20adquirir%20el%20servicio:%20${encodeURIComponent(service.title + ' - ' + service.subtitle)}`} target="_blank" rel="noopener noreferrer" class="btn-primary w-full text-center py-4 text-xs font-bold uppercase tracking-widest rounded-full block border border-white/20">
              Solicitar Asesoría por WhatsApp &rarr;
            </a>

            <p class="text-[10px] text-center text-white/40 pt-1 font-mono">
              Transacción Segura · Webpay Plus · Tarjetas de Crédito y Débito
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
