      subtitle: 'Portal Institucional B2B (Hasta 6 Secciones)',
      price: '$250.000 CLP',
      originalPrice: '$500.000 CLP',
      discount: '50% OFF',
      monthly: null,
      category: 'Web',
      description: "Sitio web corporativo de alto estándar para posicionar tu marca y captar leads calificados.",
