---

<Layout 
  title="Catálogo Oficial de Servicios & Tecnología — Vision Code SpA" 
  description="Explora todos los servicios oficiales de Vision Code: Desarrollo Web, E-Commerce, Apps Móviles, Agentes IA, Campañas en Meta Ads y Planes de Mantención Mensual con tecnología SaaS propia."
  url="https://vision-code.cl/servicios"
>
  <Navbar />
  
  <div class="fixed inset-0 z-0 pointer-events-none select-none bg-cover bg-center opacity-40" style="background-image: url('/images/fondos/1.png');"></div>
  <div class="fixed inset-0 z-0 bg-gradient-to-b from-black/90 via-black/80 to-black/95 pointer-events-none"></div>

  <main class="min-h-screen pt-36 pb-28 relative z-10 text-white bg-transparent">
    <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
      
      <!-- Encabezado Maestro -->
      <div class="mb-14 fade-up">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-lime animate-pulse shadow-[0_0_10px_rgba(184,221,46,0.9)]"></span>
          <span class="text-white/80 font-extrabold tracking-[0.25em] text-[0.72rem] uppercase drop-shadow">
            Catálogo Oficial de Soluciones Digitales 2026
          </span>
        </div>
        
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8 border-b border-white/15">
          <div>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-tight mb-4">
              Servicios <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-200 to-neutral-400">&amp; Tecnología.</span>
            </h1>
            <p class="text-base sm:text-lg text-white/70 max-w-3xl font-normal leading-relaxed">
              Desarrollamos el ecosistema digital completo para tu negocio: plataformas web, tiendas con pasarelas de pago, software SaaS propio y planes de acompañamiento mensual.
            </p>
          </div>
          
          <!-- Banner destacado a promociones -->
          <a 
            href="/promociones"
            class="shrink-0 p-4 rounded-2xl bg-white/[0.05] hover:bg-white/[0.08] border border-lime/40 hover:border-lime transition-all duration-300 flex items-center gap-4 group shadow-[0_0_25px_rgba(184,221,46,0.1)]"
          >
            <div class="w-10 h-10 rounded-xl bg-lime text-black flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(184,221,46,0.35)] group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.9 6.26 6.9.72-5.1 4.71 1.39 6.81L12 17.14l-6.09 3.36 1.39-6.81-5.1-4.71 6.9-.72L12 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-[11px] font-black text-lime uppercase tracking-widest">¿Buscas un Pack con Descuento?</div>
              <div class="text-xs text-white/90 font-bold group-hover:text-white">Ver 3 Packs Promocionales con SaaS &rarr;</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Filtros de Categoría -->
      <div class="flex flex-wrap items-center gap-2 mb-12">
        <button class="cat-filter-btn active px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white text-black border border-white shadow-md" data-category="all">
          Todos los Servicios
        </button>
        <button class="cat-filter-btn px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white/5 text-white/70 border border-white/15 hover:border-white/40 hover:text-white" data-category="web">
          Desarrollo Web
        </button>
        <button class="cat-filter-btn px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white/5 text-white/70 border border-white/15 hover:border-white/40 hover:text-white" data-category="legal">
          Constitución &amp; Legal (SII)
        </button>
        <button class="cat-filter-btn px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white/5 text-white/70 border border-white/15 hover:border-white/40 hover:text-white" data-category="ecommerce">
          Tiendas E-Commerce
        </button>
        <button class="cat-filter-btn px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white/5 text-white/70 border border-white/15 hover:border-white/40 hover:text-white" data-category="software-ia">
          Software &amp; IA
        </button>
        <button class="cat-filter-btn px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider transition-all bg-white/5 text-white/70 border border-white/15 hover:border-white/40 hover:text-white" data-category="mensuales">
          Planes Mensuales (MRR)
        </button>
      </div>

      <!-- Grid de Servicios (Estilo Promociones de Lujo) -->
      <div id="servicesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {services.map((item) => (
          <div 
            class={`service-card group relative p-8 rounded-3xl bg-[#000000] border transition-all duration-500 flex flex-col justify-between overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.95)] ${
              item.isRecommended 
                ? 'border-white/50 shadow-[0_0_35px_rgba(255,255,255,0.12)] scale-[1.02] z-10' 
                : 'border-white/15 hover:border-white/40'
            }`}
            data-cat={item.category}
          >
            {/* Top highlight bar */}
            <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${
              item.isRecommended ? 'from-lime via-white to-lime' : 'from-transparent via-white/30 to-transparent'
            }`}></div>

            <div>
              {/* Card Header */}
              <div class="flex items-center justify-between mb-5">
                <span class="text-[10px] font-black tracking-[0.2em] text-white/40 uppercase">
                  {item.categoryLabel}
                </span>
                <span class={`px-3 py-1 text-[0.62rem] font-extrabold uppercase tracking-widest rounded-full border shadow-xs ${
                  item.isRecommended 
                    ? 'bg-lime text-black border-lime font-black' 
                    : 'bg-white/10 text-white/90 border-white/20'
                }`}>
                  {item.badge}
                </span>
              </div>

              <h2 class="text-2xl font-black text-white mb-1 tracking-tight">{item.title}</h2>
              <div class="text-xs text-lime font-bold mb-3">{item.subtitle}</div>
              <p class="text-xs text-white/60 font-normal leading-relaxed mb-6 min-h-[44px]">
                {item.desc}
              </p>

              {/* Price Box con Descuento 50% OFF */}
              <div class="p-4 rounded-2xl bg-white/[0.04] border border-white/10 mb-6 flex items-center justify-between">
                <div>
                  {item.originalPrice && (
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs text-white/40 line-through font-bold">
                        {item.originalPrice}
                      </span>
                      <span class="px-2 py-0.5 rounded-full bg-lime text-black text-[9px] font-black tracking-wider uppercase">
                        {item.discount || "50% OFF"}
                      </span>
                    </div>
                  )}
                  <div class="text-3xl font-black text-white tracking-tight">{item.price}</div>
                  <div class="text-[10px] text-white/40 uppercase tracking-widest">{item.unit}</div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] font-bold text-white/50 uppercase tracking-wider">Entrega</div>
                  <div class="text-xs text-white font-bold">{item.delivery}</div>
                </div>
              </div>

              {/* Features List */}
              <div class="space-y-2.5 mb-8">
                <div class="text-[10.5px] font-bold uppercase tracking-wider text-white/50 mb-2">Lo que incluye:</div>
                {item.features.map((feat) => (
                  <div class="flex items-start gap-2 text-xs text-white/80 leading-snug">
                    <span class="w-3.5 h-3.5 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-white shrink-0 mt-0.5 text-[8.5px] font-bold">
                      ✓
                    </span>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Actions */}
            <div class="pt-4 border-t border-white/10 flex flex-col gap-2">
              <a
                href={`https://api.whatsapp.com/send?phone=56929645522&text=${encodeURIComponent(item.waMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full py-3 px-5 rounded-full text-center text-xs font-extrabold uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2 shadow-md ${
                  item.isRecommended
                    ? 'bg-lime text-black hover:bg-lime/90 hover:scale-[1.02] shadow-[0_0_20px_rgba(184,221,46,0.3)]'
                    : 'bg-white text-black hover:bg-neutral-200 hover:scale-[1.02]'
                }`}
              >
                <span>Cotizar por WhatsApp</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>

              <a
                href={`/servicio/${item.id}`}
                class="w-full py-2 text-center text-[11px] font-bold text-white/50 hover:text-white transition-colors"
              >
                Ver Ficha Técnica Completa &rarr;
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Filtros interactivos de categoría
  const buttons = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.service-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('active', 'bg-white', 'text-black', 'border-white', 'shadow-md');
        b.classList.add('bg-white/5', 'text-white/70', 'border-white/15');
      });
      btn.classList.add('active', 'bg-white', 'text-black', 'border-white', 'shadow-md');
      btn.classList.remove('bg-white/5', 'text-white/70', 'border-white/15');

      const cat = btn.getAttribute('data-category');

      cards.forEach((card: any) => {
        const itemCat = card.getAttribute('data-cat');
        if (cat === 'all' || itemCat === cat) {
          card.style.display = 'flex';
          card.style.opacity = '1';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
