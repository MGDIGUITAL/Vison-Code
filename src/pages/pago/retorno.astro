---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getFlowPaymentStatus, type FlowStatusResponse } from '../../lib/flow';

export const prerender = false;

let token = Astro.url.searchParams.get('token') || '';

if (!token && Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    token = String(formData.get('token') || '');
  } catch {}
}

let statusData: FlowStatusResponse | null = null;
let errorMsg = '';

if (token) {
  try {
    statusData = await getFlowPaymentStatus(token);
  } catch (err: any) {
    errorMsg = err.message || 'No se pudo verificar el estado del pago con Flow';
  }
}

const isSuccess = statusData?.status === 2;
const isPending = statusData?.status === 1;
const isRejected = statusData && (statusData.status === 3 || statusData.status === 4);
---

<Layout 
  title={isSuccess ? "Pago Confirmado — Vision Code SpA" : "Estado del Pago — Vision Code"}
  description="Confirmación oficial de transacción pasarela Flow.cl y Webpay Plus."
>
  <Navbar />

  <main class="min-h-screen bg-black text-white pt-32 pb-24 px-6 flex items-center justify-center relative overflow-hidden">
    <!-- Fondos con gradientes sutiles -->
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,rgba(184,221,46,0.06)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="max-w-xl w-full mx-auto relative z-10">
      
      {/* CASO: ÉXITO */}
      {isSuccess && statusData && (
        <div class="rounded-3xl border border-lime/40 bg-white/[0.03] backdrop-blur-2xl p-8 sm:p-10 shadow-[0_0_60px_rgba(184,221,46,0.15)] text-center animate-fade-in">
          
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-lime/10 border border-lime flex items-center justify-center text-lime shadow-[0_0_30px_rgba(184,221,46,0.3)]">
            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <div class="inline-block px-4 py-1 rounded-full bg-lime/20 border border-lime/50 text-lime text-xs font-black tracking-widest uppercase mb-3">
            Transacción Aprobada
          </div>

          <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white mb-2">
            ¡Pago Confirmado!
          </h1>
          <p class="text-sm text-neutral-300 font-light mb-8">
            Tu transacción fue procesada con éxito a través de <strong>Flow.cl</strong>. Hemos enviado el comprobante oficial a tu correo electrónico.
          </p>

          <!-- Resumen de Transacción -->
          <div class="rounded-2xl bg-black/60 border border-white/10 p-6 text-left space-y-3 mb-8">
            <div class="flex justify-between items-center text-xs border-b border-white/10 pb-3">
              <span class="text-neutral-400 font-mono uppercase">Concepto:</span>
              <span class="text-white font-bold">{statusData.subject}</span>
            </div>
            <div class="flex justify-between items-center text-xs border-b border-white/10 pb-3">
              <span class="text-neutral-400 font-mono uppercase">Monto Total:</span>
              <span class="text-lime font-mono font-black text-base">${statusData.amount.toLocaleString('es-CL')} CLP</span>
            </div>
            <div class="flex justify-between items-center text-xs border-b border-white/10 pb-3">
              <span class="text-neutral-400 font-mono uppercase">Medio de Pago:</span>
              <span class="text-white font-medium">{statusData.paymentData?.media || 'Webpay Plus / Tarjetas'}</span>
            </div>
            <div class="flex justify-between items-center text-xs border-b border-white/10 pb-3">
              <span class="text-neutral-400 font-mono uppercase">N.º Orden:</span>
              <span class="text-neutral-200 font-mono">{statusData.commerceOrder}</span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-neutral-400 font-mono uppercase">Pagador:</span>
              <span class="text-neutral-300">{statusData.payer}</span>
            </div>
          </div>

          <!-- Acciones de continuidad -->
          <div class="space-y-3">
            <a 
              href={`https://api.whatsapp.com/send?phone=56929645522&text=Hola%20Vision%20Code,%20acabo%20de%20pagar%20mi%20servicio%20mediante%20Flow%20(Orden:%20${encodeURIComponent(statusData.commerceOrder)}).%20%C2%BFQu%C3%A9%20pasos%20siguen?`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 px-6 rounded-full bg-lime hover:bg-lime/90 text-black font-extrabold text-xs uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2 shadow-[0_0_25px_rgba(184,221,46,0.4)] hover:scale-[1.02]"
            >
              <span>Continuar en WhatsApp con mi Project Manager &rarr;</span>
            </a>

            <a 
              href="/"
              class="w-full py-3.5 px-6 rounded-full bg-white/5 hover:bg-white/10 text-white font-bold text-xs uppercase tracking-widest border border-white/15 transition-all block text-center"
            >
              Volver al Inicio
            </a>
          </div>

        </div>
      )}

      {/* CASO: RECHAZADO O CANCELADO */}
      {isRejected && statusData && (
        <div class="rounded-3xl border border-red-500/40 bg-white/[0.03] backdrop-blur-2xl p-8 sm:p-10 shadow-[0_0_60px_rgba(239,68,68,0.15)] text-center animate-fade-in">
          
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-red-500/10 border border-red-500 flex items-center justify-center text-red-500 shadow-[0_0_30px_rgba(239,68,68,0.3)]">
            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>

          <div class="inline-block px-4 py-1 rounded-full bg-red-500/20 border border-red-500/50 text-red-400 text-xs font-black tracking-widest uppercase mb-3">
            Pago Rechazado o Cancelado
          </div>

          <h1 class="text-3xl font-black tracking-tight text-white mb-2">
            La transacción no se pudo completar
          </h1>
          <p class="text-sm text-neutral-300 font-light mb-8">
            El banco emisor o la pasarela no procesaron el cargo. No se ha realizado ningún cobro a tu cuenta.
          </p>

          <div class="space-y-3">
            <a 
              href="/promociones"
              class="w-full py-4 px-6 rounded-full bg-white hover:bg-neutral-200 text-black font-extrabold text-xs uppercase tracking-widest transition-all block text-center"
            >
              Intentar Nuevamente
            </a>
            <a 
              href="https://api.whatsapp.com/send?phone=56929645522&text=Hola%20Vision%20Code,%20tuve%20un%20problema%20al%20intentar%20pagar%20por%20Flow.%20%C2%BFMe%20pueden%20facilitar%20datos%20de%20transferencia%20bancaria?"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 px-6 rounded-full bg-white/5 hover:bg-white/10 text-white font-bold text-xs uppercase tracking-widest border border-white/15 transition-all block text-center"
            >
              Pagar vía Transferencia Bancaria Manual
            </a>
          </div>

        </div>
      )}

      {/* CASO: PENDIENTE O SIN TOKEN */}
      {(!statusData || isPending) && (
        <div class="rounded-3xl border border-white/15 bg-white/[0.03] backdrop-blur-2xl p-8 sm:p-10 text-center animate-fade-in">
          
          <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-white">
            <svg class="w-8 h-8 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </div>

          <h1 class="text-2xl font-bold tracking-tight text-white mb-2">
            Verificando Estado de la Transacción...
          </h1>
          <p class="text-sm text-neutral-400 font-light mb-6">
            {errorMsg ? errorMsg : 'Estamos consultando el resultado con Flow.cl. Si ya pagaste, tu comprobante se enviará por correo.'}
          </p>

          <a 
            href="/"
            class="inline-block py-3 px-8 rounded-full bg-white text-black font-bold text-xs uppercase tracking-widest hover:bg-neutral-200 transition-all"
          >
            Ir al Inicio
          </a>
        </div>
      )}

    </div>
  </main>

  <Footer />
</Layout>
