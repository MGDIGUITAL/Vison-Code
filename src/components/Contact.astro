    // Toggle Entidad (Persona vs Empresa)
    const entidadCards = document.querySelectorAll('.entidad-card');
    const fieldsWrapPersona = document.getElementById('fields-wrap-persona');
    const fieldsWrapEmpresa = document.getElementById('fields-wrap-empresa');

    entidadCards.forEach(card => {
      card.addEventListener('click', () => {
        entidadCards.forEach(c => {
          c.classList.remove('is-selected', 'border-2', 'border-white', 'bg-white/[0.08]', 'shadow-[0_0_30px_rgba(255,255,255,0.1)]');
          c.classList.add('border-white/20', 'bg-black');
          const chk = c.querySelector('.card-check');
          if (chk) chk.classList.add('hidden');
        });

        card.classList.add('is-selected', 'border-2', 'border-white', 'bg-white/[0.08]', 'shadow-[0_0_30px_rgba(255,255,255,0.1)]');
        card.classList.remove('border-white/20', 'bg-black');
        const chk = card.querySelector('.card-check');
        if (chk) chk.classList.remove('hidden');

        const radio = card.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          selectedEntidad = radio.value;
        }

        if (selectedEntidad === 'persona') {
          fieldsWrapPersona?.classList.remove('hidden');
          fieldsWrapEmpresa?.classList.add('hidden');
        } else {
          fieldsWrapEmpresa?.classList.remove('hidden');
          fieldsWrapPersona?.classList.add('hidden');
        }
      });
    });

    // Toggle Escala
    const escalaCards = document.querySelectorAll('.escala-card');
    escalaCards.forEach(card => {
      card.addEventListener('click', () => {
        escalaCards.forEach(c => {
          c.classList.remove('is-selected', 'border-2', 'border-white', 'bg-white/[0.08]');
          c.classList.add('border-white/20', 'bg-black');
          const chk = c.querySelector('.card-check');
          if (chk) chk.classList.add('hidden');
        });
        card.classList.add('is-selected', 'border-2', 'border-white', 'bg-white/[0.08]');
        card.classList.remove('border-white/20', 'bg-black');
        const chk = card.querySelector('.card-check');
        if (chk) chk.classList.remove('hidden');
        const radio = card.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });

    // Checkbox Servicios Multi-Select & Combos
    const servicePillCards = document.querySelectorAll('.service-pill-card');
    const serviceCountText = document.getElementById('services-count-text');

    function syncServiceCardVisual(card, isChecked) {
      const indicator = card.querySelector('.pill-check-indicator');
      if (isChecked) {
        card.classList.add('is-selected', 'border-2', 'border-white', 'bg-white/[0.12]', 'shadow-[0_0_20px_rgba(255,255,255,0.15)]');
        card.classList.remove('border-white/20', 'bg-black');
        if (indicator) {
          indicator.className = 'pill-check-indicator w-5 h-5 rounded-md border border-white bg-white flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-black text-xs shadow-[0_0_10px_rgba(255,255,255,0.4)]';
          indicator.textContent = '✓';
        }
      } else {
        card.classList.remove('is-selected', 'border-2', 'border-white', 'bg-white/[0.12]', 'shadow-[0_0_20px_rgba(255,255,255,0.15)]');
        card.classList.add('border-white/20', 'bg-black');
        if (indicator) {
          indicator.className = 'pill-check-indicator w-5 h-5 rounded-md border border-white/30 bg-black flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-bold text-xs';
          indicator.textContent = '';
        }
      }
    }

    function updateServicesCounter() {
      const checkedBoxes = document.querySelectorAll('.service-check:checked');
      const count = checkedBoxes.length;
      if (serviceCountText) {
        if (count === 0) {
          serviceCountText.textContent = '0 servicios seleccionados';
        } else if (count === 1) {
          serviceCountText.textContent = '1 servicio seleccionado';
        } else {
          serviceCountText.textContent = `${count} servicios en combo`;
        }
      }
    }

    servicePillCards.forEach(card => {
      card.addEventListener('click', () => {
        const checkbox = card.querySelector('.service-check');
        if (!checkbox) return;
        checkbox.checked = !checkbox.checked;
        syncServiceCardVisual(card, checkbox.checked);
        updateServicesCounter();
      });
    });

    // Preset Combo Buttons
    document.querySelectorAll('.btn-service-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const keysStr = btn.getAttribute('data-services') || '';
        const targetKeys = keysStr.split(',').map(s => s.trim());
        
        servicePillCards.forEach(card => {
          const key = card.getAttribute('data-service-key');
          const checkbox = card.querySelector('.service-check');
          if (!checkbox) return;
          const shouldCheck = targetKeys.includes(key);
          checkbox.checked = shouldCheck;
          syncServiceCardVisual(card, shouldCheck);
        });
        updateServicesCounter();
      });
    });

    // Clear All Services Button
    document.getElementById('btn-clear-services')?.addEventListener('click', (e) => {
      e.stopPropagation();
      servicePillCards.forEach(card => {
        const checkbox = card.querySelector('.service-check');
        if (checkbox) checkbox.checked = false;
        syncServiceCardVisual(card, false);
      });
      updateServicesCounter();
    });

    // Initialize services counter on load
    updateServicesCounter();

    // Plazo & Capital Radio Pills
    function setupRadioPills(selector, name) {
      document.querySelectorAll(selector).forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll(selector).forEach(p => {
            p.classList.remove('is-selected', 'border-2', 'border-white', 'bg-white/10');
            p.classList.add('border-white/20', 'bg-black');
          });
          pill.classList.add('is-selected', 'border-2', 'border-white', 'bg-white/10');
          pill.classList.remove('border-white/20', 'bg-black');
          const radio = pill.querySelector(`input[name="${name}"]`);
          if (radio) radio.checked = true;
        });
      });
    }
    setupRadioPills('.plazo-pill', 'f-plazo');
    setupRadioPills('.capital-pill', 'f-capital');

    function updateStep(step) {
      document.querySelectorAll('.funnel-step').forEach(s => s.classList.add('hidden'));
      const activeStep = document.getElementById(`f-step-${step}`);
      if (activeStep) activeStep.classList.remove('hidden');

      if (stepBadge) stepBadge.textContent = `PASO 0${step} / 05`;
      if (stepTitle) stepTitle.textContent = stepTitles[step] || '';
      if (progressFill) {
        progressFill.className = `absolute left-0 top-0 h-full ${stepWidths[step]} bg-gradient-to-r from-white via-neutral-200 to-white rounded-full transition-all duration-500 ease-out shadow-[0_0_15px_rgba(255,255,255,0.7)]`;
      }

      document.querySelectorAll('.step-nav-dot').forEach((dot, index) => {
        const idx = index + 1;
        const circle = dot.querySelector('.dot-circle');
        const label = dot.querySelector('.dot-label');
        if (idx <= step) {
          if (circle) {
            circle.className = idx === step 
              ? 'dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-black border-2 border-white bg-white text-black transition-all shadow-[0_0_15px_rgba(255,255,255,0.6)] scale-110'
              : 'dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border-2 border-white bg-white text-black transition-all';
            circle.textContent = idx < step ? '✓' : String(idx);
          }
          if (label) label.className = 'dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white';
        } else {
          if (circle) {
            circle.className = 'dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border border-white/30 bg-black text-white/70 transition-all';
            circle.textContent = String(idx);
          }
          if (label) label.className = 'dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white/50';
        }
      });
    }

    // Step Nav Dot Click
    document.querySelectorAll('.step-nav-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-step-target') || '1', 10);
        if (target < currentStep) {
          currentStep = target;
          updateStep(currentStep);
        }
      });
    });

    // Next Buttons
    document.querySelectorAll('.btn-step-next').forEach(btn => {
      btn.addEventListener('click', () => {
        if (currentStep === 3) {
          // Verify at least one service selected
          const checked = document.querySelectorAll('.service-check:checked');
          if (checked.length === 0) {
            alert('Por favor selecciona al menos un servicio para cotizar.');
            return;
          }
        }
        if (currentStep < 5) {
          currentStep++;
          updateStep(currentStep);
        }
      });
    });

    // Prev Buttons
    document.querySelectorAll('.btn-step-prev').forEach(btn => {
      btn.addEventListener('click', () => {
        if (currentStep > 1) {
          currentStep--;
          updateStep(currentStep);
        }
      });
    });

    // Collect Data Function
    function getFunnelData() {
      const entidad = (document.querySelector('input[name="f-entidad"]:checked'))?.value || 'persona';
      const escala = (document.querySelector('input[name="f-escala"]:checked'))?.value || 'Emprendimiento';
      
      const checkedBoxes = Array.from(document.querySelectorAll('.service-check:checked'));
      const serviciosList = checkedBoxes.map(el => el.value);
      const serviciosStr = serviciosList.length ? serviciosList.join(', ') : 'Servicios Generales';
      const plazo = (document.querySelector('input[name="f-plazo"]:checked'))?.value || 'Estándar';
      const capital = (document.querySelector('input[name="f-capital"]:checked'))?.value || 'inicial';
      const detalles = (document.getElementById('f-detalles'))?.value.trim() || '';

      let nombre = '';
      let rut = '';
      let empresa = '';
      let fono = '';
      let correo = '';

      if (entidad === 'persona') {
        nombre = (document.getElementById('p_nombre'))?.value.trim() || '';
        rut = (document.getElementById('p_rut'))?.value.trim() || 'No informado';
        empresa = (document.getElementById('p_proyecto'))?.value.trim() || 'Proyecto Personal';
        fono = (document.getElementById('p_fono'))?.value.trim() || '';
        correo = (document.getElementById('p_correo'))?.value.trim() || '';
      } else {
        empresa = (document.getElementById('e_razon'))?.value.trim() || '';
        rut = (document.getElementById('e_rut'))?.value.trim() || '';
        nombre = (document.getElementById('e_contacto'))?.value.trim() || '';
        fono = (document.getElementById('e_fono'))?.value.trim() || '';
        correo = (document.getElementById('e_correo'))?.value.trim() || '';
      }

      return {
        entidad: entidad === 'persona' ? 'Persona Natural' : 'Empresa / Persona Jurídica',
        escala,
        servicios: serviciosStr,
        serviciosList: serviciosList.length ? serviciosList : ['Servicios Generales'],
        plazo,
        capital,
        detalles,
        nombre,
        rut,
        empresa,
        fono,
        correo
      };
    }

    // Step 5 Validation & Show Summary
    const btnGenerateSummary = document.getElementById('btn-generate-final-summary');
    btnGenerateSummary?.addEventListener('click', () => {
      const data = getFunnelData();

      if (selectedEntidad === 'persona') {
        if (!data.nombre || !data.empresa || !data.fono || !data.correo) {
          alert('Por favor completa los campos obligatorios: Nombre, Nombre de Proyecto, Teléfono y Correo.');
          return;
        }
      } else {
        if (!data.empresa || !data.rut || !data.nombre || !data.fono || !data.correo) {
          alert('Por favor completa los campos obligatorios para Empresa: Razón Social, RUT, Nombre Representante, Teléfono y Correo.');
          return;
        }
      }

      // Populate summary fields
      const sumEntidad = document.getElementById('sum-entidad');
      const sumEscala = document.getElementById('sum-escala');
      const sumServicios = document.getElementById('sum-servicios');
      const sumPlazoCapital = document.getElementById('sum-plazo-capital');
      const sumContacto = document.getElementById('sum-contacto');

      if (sumEntidad) sumEntidad.textContent = data.entidad;
      if (sumEscala) sumEscala.textContent = data.escala;
      if (sumServicios) {
        sumServicios.innerHTML = data.serviciosList.map(s => 
          `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 m-1 rounded-lg text-xs font-bold bg-white/10 border border-white/25 text-white shadow-sm"><span class="text-emerald-400 font-black">✓</span> ${s}</span>`
        ).join('');
      }
      
      let capLabel = 'Capital Inicial';
      if (data.capital === 'medio') capLabel = 'Capital Mediano';
      if (data.capital === 'alto') capLabel = 'Capital Alto / Corporativo';
      if (sumPlazoCapital) sumPlazoCapital.textContent = `${data.plazo} · ${capLabel}`;
      
      if (sumContacto) sumContacto.innerHTML = `<span class="font-bold text-white">${data.nombre}</span> <span class="text-white/60">(${data.empresa})</span><br/><span class="text-xs text-white/70">Tel: ${data.fono} &nbsp;|&nbsp; Email: ${data.correo}</span>`;

      // Build WhatsApp message with ultra-clean breakdown of all customer details and services
      const waServicesFormatted = data.serviciosList.length > 1
        ? '\n' + data.serviciosList.map(s => `  ✓ ${s}`).join('\n')
        : ` ${data.servicios}`;

      const waText = 
        `📋 *SOLICITUD DE COTIZACIÓN FORMAL — VISION CODE*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n` +
        `👤 *DATOS DEL CLIENTE*\n` +
        `• *Nombre / Solicitante:* ${data.nombre}\n` +
        `• *Empresa / Proyecto:* ${data.empresa}\n` +
        `• *RUT / Identificación:* ${data.rut}\n` +
        `• *Tipo de Solicitante:* ${data.entidad}\n` +
        `• *Teléfono:* ${data.fono}\n` +
        `• *Correo:* ${data.correo}\n\n` +
        `⚙️ *DESGLOSE DE SERVICIOS*\n` +
        `• *Escala de Operación:* ${data.escala}\n` +
        `• *Servicios Solicitados:*${waServicesFormatted}\n` +
        `• *Plazo Estimado:* ${data.plazo}\n` +
        `• *Rango de Inversión / Capital:* ${capLabel}\n` +
        (data.detalles ? `• *Requerimientos específicos:* ${data.detalles}\n` : '') +
        `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `💬 _Hola equipo de Vision Code, acabo de completar el embudo de cotización en el sitio web y solicito mi propuesta formal con este desglose._`;

      const waUrl = `https://api.whatsapp.com/send?phone=56929645522&text=${encodeURIComponent(waText)}`;
      const waBtn = document.getElementById('btn-cotizar-whatsapp');
      if (waBtn) waBtn.href = waUrl;

      const succWaDirect = document.getElementById('succ-direct-wa');
      if (succWaDirect) succWaDirect.href = waUrl;

      // Switch view
      form?.classList.add('hidden');
      progressWrap?.classList.add('hidden');
      summaryPanel?.classList.remove('hidden');
      summaryPanel?.scrollIntoView({ behavior: 'smooth' });
    });

    // Modify funnel button
    document.getElementById('btn-edit-funnel')?.addEventListener('click', () => {
      summaryPanel?.classList.add('hidden');
      progressWrap?.classList.remove('hidden');
      form?.classList.remove('hidden');
      currentStep = 5;
      updateStep(5);
    });

    // Submit via Web (Email)
    const btnCotizarWeb = document.getElementById('btn-cotizar-web');
    btnCotizarWeb?.addEventListener('click', async () => {
      const data = getFunnelData();
      const honeypot = (document.getElementById('funnel_honeypot'))?.value;

      btnCotizarWeb.setAttribute('disabled', 'true');
      btnCotizarWeb.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-black inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Enviando Solicitud Formal...</span>
      `;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tipo_cliente: selectedEntidad,
            rango_operacion: data.escala,
            rut: data.rut,
            empresa: data.empresa,
            nombre_fantasia: data.empresa,
            solicitante: data.nombre,
            telefono: data.fono,
            correo: data.correo,
            modelo_negocio: 'servicios',
            nivel_capital: data.capital,
            plazo: data.plazo,
            servicio: data.servicios,
            propuesta_detalles: data.detalles,
            _honeypot: honeypot
          })
        });

        const resData = await res.json();
        if (res.ok && resData.success) {
          const succEmail = document.getElementById('succ-display-email');
          if (succEmail) succEmail.textContent = data.correo;
          summaryPanel?.classList.add('hidden');
          successPanel?.classList.remove('hidden');
          successPanel?.scrollIntoView({ behavior: 'smooth' });
        } else {
          alert(resData.error || 'Ocurrió un error al enviar. Puedes intentar directamente por WhatsApp.');
          btnCotizarWeb.removeAttribute('disabled');
          btnCotizarWeb.innerHTML = `
            <svg width="18" height="18" class="shrink-0 text-black" style="width: 18px; height: 18px; min-width: 18px; max-width: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Solicitar por Correo</span>
          `;
        }
      } catch (err) {
        console.error(err);
        alert('Error de conexión. Intente por WhatsApp o reintente en unos segundos.');
        btnCotizarWeb.removeAttribute('disabled');
        btnCotizarWeb.innerHTML = `
          <svg width="18" height="18" class="shrink-0 text-black" style="width: 18px; height: 18px; min-width: 18px; max-width: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Solicitar por Correo</span>
        `;
      }
    });

    // Start New Funnel
    document.getElementById('btn-new-funnel')?.addEventListener('click', () => {
      form?.reset();
      currentStep = 1;
      updateStep(1);
      successPanel?.classList.add('hidden');
      summaryPanel?.classList.add('hidden');
      progressWrap?.classList.remove('hidden');
      form?.classList.remove('hidden');
    });

  });
</script>
