---
---

<section id="contacto" class="py-28 relative z-10 border-t border-white/10 bg-black text-white overflow-hidden">
  
  <!-- Fondo de sección: 1.png de fondos nuevos -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none bg-cover bg-center" style="background-image: url('/images/fondos/1.png');"></div>
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/85 via-black/75 to-black/90 pointer-events-none"></div>
  
  <!-- Sutil glow de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-white/[0.02] rounded-full blur-[140px] pointer-events-none select-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado del Embudo -->
    <div class="text-center mb-12 fade-up">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/15 text-[0.68rem] font-black uppercase tracking-[0.25em] text-white/80 mb-5 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-white animate-pulse shadow-[0_0_10px_rgba(255,255,255,0.9)]"></span>
        <span>Embudo de Diagnóstico &amp; Cotización Formal</span>
      </div>
      
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] mb-5">
        Cotiza tu proyecto a medida <br class="hidden sm:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-200 to-neutral-400">
          con nuestro equipo técnico.
        </span>
      </h2>
      
      <p class="text-sm sm:text-base text-white/70 max-w-2xl mx-auto font-normal leading-relaxed">
        Cuéntanos tu necesidad técnica y la escala de tu negocio. Con esta información te enviaremos una <strong>propuesta formal detallada</strong> vía WhatsApp o correo electrónico.
      </p>
    </div>

    <!-- Contenedor Maestro del Embudo (Pure Black OLED #000000) -->
    <div class="bg-[#000000] border border-white/20 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-[0_30px_90px_rgba(0,0,0,0.95)] backdrop-blur-2xl relative overflow-hidden">
      
      <!-- Barra de Progreso y Pasos -->
      <div class="mb-10 pb-8 border-b border-white/15" id="funnel-progress-wrap">
        <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider mb-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white font-mono text-[0.7rem] tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
            <span id="funnel-step-badge">PASO 01 / 05</span>
          </div>
          <span id="funnel-step-title" class="text-white/90 font-black tracking-wider text-xs uppercase">
            TIPO DE ENTIDAD
          </span>
        </div>

        <!-- Barra de llenado -->
        <div class="relative w-full h-1.5 bg-white/15 rounded-full overflow-hidden">
          <div id="funnel-progress-fill" class="absolute left-0 top-0 h-full w-1/5 bg-gradient-to-r from-white via-neutral-200 to-white rounded-full transition-all duration-500 ease-out shadow-[0_0_15px_rgba(255,255,255,0.7)]"></div>
        </div>

        <!-- Indicador de pasos conectados -->
        <div class="grid grid-cols-5 gap-2 text-center mt-6">
          <div class="step-nav-dot cursor-pointer group" data-step-target="1">
            <div class="dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-black border-2 border-white bg-white text-black transition-all shadow-[0_0_15px_rgba(255,255,255,0.6)]">1</div>
            <span class="dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white">Entidad</span>
          </div>
          <div class="step-nav-dot cursor-pointer group" data-step-target="2">
            <div class="dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border border-white/30 bg-black text-white/70 transition-all">2</div>
            <span class="dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white/50">Escala</span>
          </div>
          <div class="step-nav-dot cursor-pointer group" data-step-target="3">
            <div class="dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border border-white/30 bg-black text-white/70 transition-all">3</div>
            <span class="dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white/50">Servicios</span>
          </div>
          <div class="step-nav-dot cursor-pointer group" data-step-target="4">
            <div class="dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border border-white/30 bg-black text-white/70 transition-all">4</div>
            <span class="dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white/50">Alcance</span>
          </div>
          <div class="step-nav-dot cursor-pointer group" data-step-target="5">
            <div class="dot-circle w-7 h-7 mx-auto rounded-full flex items-center justify-center text-[0.7rem] font-bold border border-white/30 bg-black text-white/70 transition-all">5</div>
            <span class="dot-label hidden sm:block text-[0.62rem] font-bold uppercase tracking-wider mt-1.5 text-white/50">Contacto</span>
          </div>
        </div>
      </div>

      <!-- FORMULARIO INTERACTIVO MULTI-PASO -->
      <form id="funnelForm" onsubmit="return false;" class="relative">
        <input type="text" id="funnel_honeypot" class="hidden" autocomplete="off" tabindex="-1" />

        <!-- ══════════════════════════════════════════════
             PASO 1: PERSONA NATURAL VS EMPRESA
        ══════════════════════════════════════════════ -->
        <div class="funnel-step" id="f-step-1">
          <div class="mb-6">
            <span class="text-[0.68rem] font-black uppercase tracking-[0.25em] text-white/50 block mb-1">Paso 01</span>
            <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">¿Cómo deseas solicitar este proyecto?</h3>
            <p class="text-sm text-white/70 font-normal">Indica si operas como Persona Natural con un proyecto personal o como Empresa / Persona Jurídica formal.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 my-8">
            <!-- Opción Persona Natural -->
            <label class="entidad-card is-selected group p-6 rounded-2xl border-2 border-white bg-white/[0.08] cursor-pointer transition-all duration-300 relative flex flex-col justify-between hover:-translate-y-1 shadow-[0_0_30px_rgba(255,255,255,0.1)]">
              <input type="radio" name="f-entidad" value="persona" class="sr-only" checked />
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                  <span class="card-check w-6 h-6 rounded-full bg-white text-black text-xs font-bold flex items-center justify-center shadow-md">✓</span>
                </div>
                <h4 class="text-xl font-black text-white mb-2">Persona Natural</h4>
                <p class="text-xs text-white/70 leading-relaxed font-normal">Profesional independiente, creador, o persona iniciando un nuevo proyecto sin razón social aún.</p>
              </div>
              <div class="mt-6 pt-3 border-t border-white/15 text-[0.68rem] font-bold uppercase tracking-wider text-white/90">
                Proyecto Personal o Emprendedor &rarr;
              </div>
            </label>

            <!-- Opción Empresa -->
            <label class="entidad-card group p-6 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-300 relative flex flex-col justify-between hover:-translate-y-1 hover:border-white/40">
              <input type="radio" name="f-entidad" value="empresa" class="sr-only" />
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1m-1-4h.01M9 16h.01M9 12h.01M9 8h.01M15 16h.01M15 12h.01M15 8h.01"/>
                    </svg>
                  </div>
                  <span class="card-check hidden w-6 h-6 rounded-full bg-white text-black text-xs font-bold flex items-center justify-center shadow-md">✓</span>
                </div>
                <h4 class="text-xl font-black text-white mb-2">Empresa / Jurídica</h4>
                <p class="text-xs text-white/70 leading-relaxed font-normal">Sociedad SpA, EIRL, Ltda. o entidad con RUT tributario que requiere factura o contratos comerciales.</p>
              </div>
              <div class="mt-6 pt-3 border-t border-white/15 text-[0.68rem] font-bold uppercase tracking-wider text-white/60 group-hover:text-white">
                Razón Social &amp; Facturación &rarr;
              </div>
            </label>
          </div>

          <div class="mt-8 flex justify-end">
            <button type="button" class="btn-step-next bg-white hover:bg-neutral-200 text-black px-8 py-3.5 rounded-full font-black text-xs uppercase tracking-widest transition-all duration-300 shadow-[0_0_25px_rgba(255,255,255,0.3)] hover:scale-105 active:scale-95 flex items-center gap-2">
              <span>Continuar a Escala de Operación</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <!-- ══════════════════════════════════════════════
             PASO 2: RANGO / ESCALA (Emprendimiento, Empresa, Corporación)
        ══════════════════════════════════════════════ -->
        <div class="funnel-step hidden" id="f-step-2">
          <div class="mb-6">
            <span class="text-[0.68rem] font-black uppercase tracking-[0.25em] text-white/50 block mb-1">Paso 02</span>
            <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">¿En qué rango u escala opera tu negocio?</h3>
            <p class="text-sm text-white/70 font-normal">Esto nos permite estructurar la arquitectura y dimensionar los recursos exactos para tu cotización.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 my-8">
            <!-- Emprendimiento -->
            <label class="escala-card is-selected group p-6 rounded-2xl border-2 border-white bg-white/[0.08] cursor-pointer transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
              <input type="radio" name="f-escala" value="Emprendimiento" class="sr-only" checked />
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[0.62rem] font-black uppercase tracking-widest text-white/60">Rango 01</span>
                  <span class="card-check w-5 h-5 rounded-full bg-white text-black text-[0.65rem] font-bold flex items-center justify-center">✓</span>
                </div>
                <h4 class="text-lg font-black text-white mb-2">Emprendimiento</h4>
                <p class="text-xs text-white/70 leading-relaxed font-normal">En fase inicial, validando mercado, captando primeros clientes y optimizando presupuesto de lanzamiento.</p>
              </div>
              <div class="mt-5 pt-3 border-t border-white/15 text-[0.65rem] font-bold uppercase tracking-wider text-white/70">
                Lanzamiento Ágil
              </div>
            </label>

            <!-- Empresa / PYME -->
            <label class="escala-card group p-6 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-300 flex flex-col justify-between hover:-translate-y-1 hover:border-white/40">
              <input type="radio" name="f-escala" value="Empresa / PYME" class="sr-only" />
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[0.62rem] font-black uppercase tracking-widest text-white/60">Rango 02</span>
                  <span class="card-check hidden w-5 h-5 rounded-full bg-white text-black text-[0.65rem] font-bold flex items-center justify-center">✓</span>
                </div>
                <h4 class="text-lg font-black text-white mb-2">Empresa / PYME</h4>
                <p class="text-xs text-white/70 leading-relaxed font-normal">Negocio en marcha consolidado, equipo de trabajo activo, buscando escalar ventas y automatizar procesos.</p>
              </div>
              <div class="mt-5 pt-3 border-t border-white/15 text-[0.65rem] font-bold uppercase tracking-wider text-white/70">
                Crecimiento Comercial
              </div>
            </label>

            <!-- Corporación -->
            <label class="escala-card group p-6 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-300 flex flex-col justify-between hover:-translate-y-1 hover:border-white/40">
              <input type="radio" name="f-escala" value="Corporación" class="sr-only" />
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[0.62rem] font-black uppercase tracking-widest text-white/60">Rango 03</span>
                  <span class="card-check hidden w-5 h-5 rounded-full bg-white text-black text-[0.65rem] font-bold flex items-center justify-center">✓</span>
                </div>
                <h4 class="text-lg font-black text-white mb-2">Corporación</h4>
                <p class="text-xs text-white/70 leading-relaxed font-normal">Alto volumen operacional, infraestructura de alta seguridad, integraciones complejas ERP/CRM y apps dedicadas.</p>
              </div>
              <div class="mt-5 pt-3 border-t border-white/15 text-[0.65rem] font-bold uppercase tracking-wider text-white/70">
                Soluciones Enterprise
              </div>
            </label>
          </div>

          <div class="mt-8 flex justify-between items-center">
            <button type="button" class="btn-step-prev border border-white/30 text-white/80 hover:text-white px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider hover:bg-white/5 transition-all">
              &larr; Volver
            </button>
            <button type="button" class="btn-step-next bg-white hover:bg-neutral-200 text-black px-8 py-3.5 rounded-full font-black text-xs uppercase tracking-widest transition-all duration-300 shadow-[0_0_25px_rgba(255,255,255,0.3)] hover:scale-105 active:scale-95 flex items-center gap-2">
              <span>Continuar a Servicios</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <!-- ══════════════════════════════════════════════
             PASO 3: SELECCIÓN DE SERVICIOS
        ══════════════════════════════════════════════ -->
        <div class="funnel-step hidden" id="f-step-3">
          <div class="mb-5 flex flex-col md:flex-row md:items-end md:justify-between gap-3">
            <div>
              <span class="text-[0.68rem] font-black uppercase tracking-[0.25em] text-white/50 block mb-1">Paso 03</span>
              <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-1.5">¿Qué servicio o solución requieres?</h3>
              <p class="text-sm text-white/70 font-normal">Puedes marcar <strong class="text-white">uno o varios servicios</strong> simultáneamente para cotizar un paquete o solución integral.</p>
            </div>
            <div id="services-counter-badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-mono font-bold text-white shrink-0 self-start md:self-auto">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="services-count-text">1 servicio seleccionado</span>
            </div>
          </div>

          <!-- Quick Combo Presets -->
          <div class="mb-6 p-4 rounded-2xl bg-white/[0.03] border border-white/15">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-[0.65rem] font-black uppercase tracking-wider text-white/70 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>Armar Paquete / Combo Rápido:</span>
              </span>
              <button type="button" id="btn-clear-services" class="text-[0.65rem] font-bold text-white/40 hover:text-white transition-colors underline cursor-pointer">
                Desmarcar todos
              </button>
            </div>
            <div class="flex flex-wrap gap-2">
              <button type="button" class="btn-service-preset px-3 py-1.5 rounded-full text-xs font-bold bg-black border border-white/25 hover:border-white text-white/90 hover:text-white transition-all flex items-center gap-2 hover:scale-[1.02] cursor-pointer" data-services="web,app,ia">
                <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>Combo: E-Commerce + App Móvil + Agente IA</span>
              </button>
              <button type="button" class="btn-service-preset px-3 py-1.5 rounded-full text-xs font-bold bg-black border border-white/25 hover:border-white text-white/90 hover:text-white transition-all flex items-center gap-2 hover:scale-[1.02] cursor-pointer" data-services="web,ads">
                <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <span>Pack Growth: Web E-Commerce + Meta Ads</span>
              </button>
              <button type="button" class="btn-service-preset px-3 py-1.5 rounded-full text-xs font-bold bg-black border border-white/25 hover:border-white text-white/90 hover:text-white transition-all flex items-center gap-2 hover:scale-[1.02] cursor-pointer" data-services="web,app,erp,ia">
                <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1m-1-4h.01M9 16h.01M9 12h.01M9 8h.01M15 16h.01M15 12h.01M15 8h.01" />
                </svg>
                <span>Ecosistema Total (Web + App + ERP + IA)</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4.5 my-6" id="services-checklist">
            
            <!-- 1. Apps Móviles iOS & Android (NUEVO) -->
            <div class="service-pill-card group p-5 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-200 flex items-start gap-4 hover:border-white/40 hover:-translate-y-0.5 select-none" data-service-key="app">
              <input type="checkbox" name="f-servicios" value="Aplicaciones Móviles (iOS & Android)" class="sr-only service-check" />
              <div class="pill-check-indicator w-5 h-5 rounded-md border border-white/30 bg-black flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-bold text-xs"></div>
              <div>
                <span class="text-[0.62rem] font-black uppercase tracking-wider text-emerald-400 block mb-1">Ecosistema Móvil</span>
                <h4 class="text-sm font-black text-white mb-1">Apps iOS &amp; Android</h4>
                <p class="text-xs text-white/60 leading-relaxed font-normal">Desarrollo nativo e híbrido publicado en App Store y Google Play.</p>
              </div>
            </div>

            <!-- 2. Desarrollo Web & SEO -->
            <div class="service-pill-card is-selected group p-5 rounded-2xl border-2 border-white bg-white/[0.08] cursor-pointer transition-all duration-200 flex items-start gap-4 hover:border-white hover:-translate-y-0.5 select-none" data-service-key="web">
              <input type="checkbox" name="f-servicios" value="Desarrollo Web & E-Commerce con SEO" class="sr-only service-check" checked />
              <div class="pill-check-indicator w-5 h-5 rounded-md border border-white bg-white flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-bold text-xs">✓</div>
              <div>
                <span class="text-[0.62rem] font-black uppercase tracking-wider text-white/60 block mb-1">Presencia Digital</span>
                <h4 class="text-sm font-black text-white mb-1">Desarrollo Web &amp; E-Commerce</h4>
                <p class="text-xs text-white/60 leading-relaxed font-normal">Páginas de alta velocidad optimizadas para posicionamiento SEO en Google.</p>
              </div>
            </div>

            <!-- 3. Campañas Meta Ads -->
            <div class="service-pill-card group p-5 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-200 flex items-start gap-4 hover:border-white/40 hover:-translate-y-0.5 select-none" data-service-key="ads">
              <input type="checkbox" name="f-servicios" value="Campañas Publicitarias Meta Ads (FB & IG)" class="sr-only service-check" />
              <div class="pill-check-indicator w-5 h-5 rounded-md border border-white/30 bg-black flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-bold text-xs"></div>
              <div>
                <span class="text-[0.62rem] font-black uppercase tracking-wider text-white/60 block mb-1">Adquisición</span>
                <h4 class="text-sm font-black text-white mb-1">Campañas Meta Ads (FB/IG)</h4>
                <p class="text-xs text-white/60 leading-relaxed font-normal">Anuncios de alta conversión para atraer clientes cualificados a tus canales.</p>
              </div>
            </div>

            <!-- 4. Agentes IA & WhatsApp -->
            <div class="service-pill-card group p-5 rounded-2xl border border-white/20 bg-black cursor-pointer transition-all duration-200 flex items-start gap-4 hover:border-white/40 hover:-translate-y-0.5 select-none" data-service-key="ia">
              <input type="checkbox" name="f-servicios" value="Agentes IA & Automatización en WhatsApp" class="sr-only service-check" />
              <div class="pill-check-indicator w-5 h-5 rounded-md border border-white/30 bg-black flex items-center justify-center shrink-0 mt-0.5 transition-all text-black font-bold text-xs"></div>
              <div>
                <span class="text-[0.62rem] font-black uppercase tracking-wider text-white/60 block mb-1">Automatización 24/7</span>
                <h4 class="text-sm font-black text-white mb-1">Agentes IA WhatsApp</h4>
                <p class="text-xs text-white/60 leading-relaxed font-normal">Asistentes inteligentes que atienden, cotizan y agendan citas día y noche.</p>
              </div>
            </div>

            <!-- 5. Software a Medida & ERP -->
