---
---

<section id="impacto" class="py-40 relative z-10 overflow-hidden bg-black text-white animate-fade-in">
  
  <!-- Background image: 3.png de fondos nuevos -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/fondos/3.png');"></div>
    <!-- Dark overlay para legibilidad -->
    <div class="absolute inset-0 bg-black/80 backdrop-blur-[1px]"></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-6 lg:px-12 relative z-10">
    
    <div class="flex flex-col md:flex-row justify-between items-end gap-10 mb-24 fade-up">
      <div class="max-w-4xl">
        <div class="saas-badge border-none text-white/80 bg-transparent font-bold tracking-[0.25em] text-[0.7rem] px-0 uppercase mb-4">Ingeniería &amp; Resultados</div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
          Infraestructura digital <br/>
          <span class="h-[1.2em] relative overflow-hidden w-full text-white block select-none">
            <span id="rotate-project-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-100 translate-y-0 transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
              diseñada para escalar.
            </span>
          </span>
        </h2>
        <p class="text-lg sm:text-xl text-white/70 font-normal leading-relaxed max-w-3xl border-l-2 border-white/40 pl-5">
          Construimos <strong class="text-white font-bold">tecnología de alta fidelidad</strong>. Desarrollamos código optimizado y sistemas a medida enfocados en consolidar autoridad, automatizar operaciones y maximizar la adquisición de clientes.
        </p>
      </div>

      <a href="/proyectos" class="inline-flex items-center gap-3 bg-white text-black font-extrabold text-xs uppercase tracking-widest px-8 py-4 rounded-full transition-all duration-300 hover:bg-neutral-200 hover:shadow-[0_8px_30px_rgba(255,255,255,0.25)] hover:scale-[1.02] shrink-0">
        Ver Galería de Proyectos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Editorial Bento Grid for Business Pitch -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[minmax(240px,auto)] mb-24">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-[#000000] border border-white/15 hover:border-white/40 shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 rounded-2xl text-white" style="transition-delay: 0s">
        <div class="relative z-10 max-w-2xl">
          <span class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/50 mb-3 block">Rendimiento</span>
          <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-neutral-200 transition-colors duration-300">Optimización de Conversión (CRO)</h3>
          <p class="text-base sm:text-lg text-white/70 leading-relaxed font-normal">
            Implementamos arquitecturas web de velocidad extrema y posicionamiento SEO técnico para transformar visitas en oportunidades de negocio reales.
          </p>
        </div>
      </article>

      <!-- Card 2 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#000000] border border-white/15 hover:border-white/40 shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 rounded-2xl text-white" style="transition-delay: 0.15s">
        <div class="relative z-10">
          <span class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/50 mb-3 block">Arquitectura</span>
          <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-neutral-200 transition-colors duration-300">Desarrollo <br/> Full Stack</h3>
          <p class="text-base text-white/70 leading-relaxed font-normal">
            Soluciones robustas a medida, integrando interfaces modernas con lógica de servidor eficiente y segura.
          </p>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#000000] border border-white/15 hover:border-white/40 shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 rounded-2xl text-white" style="transition-delay: 0.3s">
        <div class="relative z-10">
          <span class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/50 mb-3 block">Posicionamiento</span>
          <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-neutral-200 transition-colors duration-300">Autoridad <br/> Corporativa 24/7</h3>
          <p class="text-base text-white/70 leading-relaxed font-normal">
            Tu portal web proyecta una imagen de alto nivel institucional que genera confianza inmediata en tus prospectos.
          </p>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-[#000000] border border-white/15 hover:border-white/40 shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 rounded-2xl text-white" style="transition-delay: 0.45s">
        <div class="relative z-10">
          <span class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/50 mb-3 block">Innovación</span>
          <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-neutral-200 transition-colors duration-300">Sistemas &amp; Inteligencia Artificial</h3>
          <p class="text-base sm:text-lg text-white/70 leading-relaxed font-normal">
            Integramos modelos de IA para atención y cualificación automática de prospectos vía WhatsApp y web, optimizando tus operaciones de ventas.
          </p>
        </div>
      </article>

    </div>

    <!-- SECCIÓN DE CLIENTES REALES: Sitios Web Hechos por Vision Code -->
    <div class="border-t border-white/10 pt-20">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-white text-[0.65rem] font-bold uppercase tracking-[0.2em] mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            PORTAFOLIO OFICIAL EN PRODUCCIÓN
          </div>
          <h3 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            Sitios Web Desarrollados por Vision Code
          </h3>
          <p class="text-sm sm:text-base text-white/70 mt-2 max-w-2xl font-normal">
            Plataformas reales activas en producción para empresas chilenas que confían en nuestra ingeniería.
          </p>
        </div>

        <a 
          href="/proyectos" 
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-white hover:text-neutral-300 border-b border-white/30 hover:border-white pb-1 transition-all"
        >
          Explorar Catálogo Completo (6 Proyectos) &rarr;
        </a>
      </div>

      <!-- Grid de 3 Columnas con los Sitios Web en Vivo -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {[
          {
            name: "Glowy Skin Chile",
            domain: "glowyskin.cl",
            category: "E-Commerce Skincare Coreano",
            image: "/images/proyectos/glowyskin.png",
            liveUrl: "https://glowyskin.cl/",
            badge: "Alta Conversión"
          },
          {
            name: "SPM Store",
            domain: "spm-store.cl",
            category: "Retail Streetwear & Drops",
            image: "/images/proyectos/spm-store.png",
            liveUrl: "https://www.spm-store.cl/",
            badge: "10K+ Visitas"
          },
          {
            name: "Amora Jewelry",
            domain: "amorajewelry.cl",
            category: "Boutique Joyería Fina",
            image: "/images/proyectos/amorajewelry.png",
            liveUrl: "https://amorajewelry.cl/",
            badge: "Diseño Luxury"
          },
          {
            name: "NOVA Performance®",
            domain: "novaperformance.cl",
            category: "Biotecnología & Salud",
            image: "/images/proyectos/novaperformance.png",
            liveUrl: "https://www.novaperformance.cl/",
            badge: "Vanguardia Web"
          },
          {
            name: "Quincho Tabolango",
            domain: "quinchotabolango.cl",
            category: "Landing & Reservas Directas",
            image: "/images/proyectos/quinchotabolango.png",
            liveUrl: "https://www.quinchotabolango.cl/",
            badge: "Captación WhatsApp"
          },
          {
            name: "Peritum Abogados",
            domain: "peritum.cl",
            category: "Estudio Jurídico & Tributario",
            image: "/images/proyectos/peritum.png",
            liveUrl: "https://www.peritum.cl/",
            badge: "Firma Las Condes"
          }
        ].map((item) => (
          <div class="group relative bg-[#000000] border border-white/15 hover:border-white/40 rounded-2xl overflow-hidden shadow-2xl transition-all duration-300 hover:-translate-y-2 flex flex-col justify-between">
            <a 
              href={item.liveUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="relative h-48 sm:h-52 overflow-hidden bg-black block group/img"
              title={"Visitar sitio web: " + item.domain}
            >
              <img 
                src={item.image} 
                alt={item.name} 
                loading="lazy" 
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover/img:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent pointer-events-none"></div>
              
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="px-2.5 py-0.5 rounded-full bg-black/80 backdrop-blur-md border border-white/20 text-white text-[0.6rem] font-bold uppercase tracking-wider">
                  {item.badge}
                </span>
              </div>

              <div class="absolute bottom-3 right-3 opacity-90 group-hover/img:opacity-100 transition-opacity">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/30 text-white text-[0.6rem] font-bold group-hover/img:bg-white group-hover/img:text-black transition-colors">
                  <span>En vivo</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </span>
              </div>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="text-[0.65rem] font-mono text-white/50 uppercase tracking-widest mb-1">{item.category}</div>
                <h4 class="text-lg font-bold text-white tracking-tight group-hover:text-neutral-200 transition-colors">
                  {item.name}
                </h4>
              </div>

              <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between">
                <a 
                  href={item.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-xs font-mono text-neutral-400 hover:text-white transition-colors flex items-center gap-1"
                >
                  <span>{item.domain}</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>

                <a 
                  href={item.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[0.68rem] font-bold uppercase tracking-wider text-white hover:underline inline-flex items-center gap-1"
                >
                  Visitar &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const phrases = [
      "diseñada para escalar.",
      "orientada a resultados.",
      "optimizada para convertir.",
      "al servicio de tu empresa."
    ];

    function initProjectRotator() {
      const rotateEl = document.getElementById('rotate-project-text');
      if (!rotateEl) return;

      let currentIndex = 0;
      function rotateWord() {
        if (!rotateEl) return;
        rotateEl.style.opacity = '0';
        rotateEl.style.transform = 'translateY(-20px)';

        setTimeout(() => {
          currentIndex = (currentIndex + 1) % phrases.length;
          rotateEl.textContent = phrases[currentIndex];
          rotateEl.style.transform = 'translateY(20px)';

          requestAnimationFrame(() => {
            setTimeout(() => {
              rotateEl.style.opacity = '1';
              rotateEl.style.transform = 'translateY(0)';
            }, 40);
          });
        }, 400);
      }

      setInterval(rotateWord, 3200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectRotator);
    } else {
      initProjectRotator();
    }
    document.addEventListener('astro:page-load', initProjectRotator);
  })();
</script>
