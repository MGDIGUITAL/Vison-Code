<style>
#vc-agent {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9999;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
#vc-bubble {
  width: 58px;
  height: 58px;
  border-radius: 9999px;
  background: #000000;
  border: 1px solid #000000;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
}
#vc-bubble::before {
  content: '';
  position: absolute;
  inset: -4px;
  border: 1px solid rgba(0, 0, 0, 0.3);
  border-radius: 9999px;
  opacity: 0.4;
  animation: bubblePulse 2.5s infinite cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}
@keyframes bubblePulse {
  0% { transform: scale(0.95); opacity: 0.5; }
  100% { transform: scale(1.25); opacity: 0; }
}
#vc-bubble:hover {
  transform: translateY(-3px) scale(1.04);
  background: #18181b;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
}
#ico-chat, #ico-x {
  transition: all 0.3s ease;
}
#ico-x {
  display: none;
  position: absolute;
}
#vc-tooltip {
  position: absolute;
  right: 72px;
  top: 50%;
  transform: translateY(-50%) translateX(10px);
  background: #000000;
  border: 1px solid #000000;
  color: #ffffff;
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  white-space: nowrap;
  border-radius: 6px;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 8px 20px rgba(0,0,0,0.25);
}
#vc-bubble:hover #vc-tooltip {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}
#vc-dot {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 10px;
  height: 10px;
  background: #25D366;
  border-radius: 9999px;
  border: 2px solid #000000;
}
#vc-panel {
  position: absolute;
  bottom: 72px;
  right: 0;
  width: 370px;
  background: #ffffff;
  border: 1.5px solid #000000;
  border-radius: 16px;
  overflow: hidden;
  display: none;
  flex-direction: column;
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
}
@media (max-width: 420px) {
  #vc-panel {
    width: calc(100vw - 36px);
    right: -12px;
  }
}
#vc-panel.open {
  display: flex;
  animation: pin 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes pin {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
#vc-header {
  background: #000000;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1px solid #000000;
}
#vc-close {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  font-size: 22px;
  padding: 0;
  line-height: 1;
  transition: color 0.2s ease;
}
#vc-close:hover {
  color: #ffffff;
}
#vc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 12px;
  background: #f8f9fa;
  border-bottom: 1px solid #e5e7eb;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  color: #111111 !important;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
}
.chip svg {
  flex-shrink: 0;
  stroke: #111111;
  transition: stroke 0.2s ease;
}
.chip:hover {
  background: #000000;
  color: #ffffff !important;
  border-color: #000000;
}
.chip:hover svg {
  stroke: #ffffff;
}
#vc-msgs {
  flex: 1;
  min-height: 290px;
  max-height: 350px;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #ffffff;
}
#vc-msgs::-webkit-scrollbar {
  width: 4px;
}
#vc-msgs::-webkit-scrollbar-thumb {
  background: #d1d5db;
  border-radius: 4px;
}
.msg {
  max-width: 86%;
  padding: 12px 16px;
  font-size: 13px;
  line-height: 1.6;
  white-space: pre-line;
}
.bot {
  background: #f4f4f6;
  border: 1px solid #e4e4e7;
  color: #09090b !important;
  align-self: flex-start;
  border-radius: 12px 12px 12px 2px;
}
.usr {
  background: #000000;
  color: #ffffff !important;
  align-self: flex-end;
  font-weight: 600;
  border-radius: 12px 12px 2px 12px;
}
.tdots {
  color: #71717a;
  font-style: italic;
  font-size: 12px;
  background: transparent;
  border: none;
  padding: 6px 16px;
  align-self: flex-start;
}
.dots-wrap {
  display: inline-flex;
  gap: 4px;
  align-items: center;
}
.dots-wrap span {
  width: 6px;
  height: 6px;
  background: #111111;
  border-radius: 9999px;
  animation: bd 1.2s infinite;
}
.dots-wrap span:nth-child(2) { animation-delay: .2s; }
.dots-wrap span:nth-child(3) { animation-delay: .4s; }
@keyframes bd {
  0%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6px); background: #000000; }
}
.wa-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 4px 0;
  padding: 12px 18px;
  background: #000000;
  color: #ffffff !important;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s ease;
}
.wa-btn:hover {
  background: #27272a;
}
.scard {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-left: 3px solid #000000;
  border-radius: 8px;
  padding: 14px 16px;
  font-size: 12.5px;
  color: #111111 !important;
  line-height: 1.7;
}
.scard strong {
  color: #000000 !important;
  display: block;
  margin-bottom: 4px;
  font-size: 13.5px;
  font-weight: 700;
}
#vc-lead {
  flex-direction: column;
  gap: 8px;
  padding: 14px 16px 16px;
  background: #f8f9fa;
  border-top: 1px solid #e5e7eb;
}
#vc-lead input {
  width: 100%;
  font-size: 12.5px;
  padding: 10px 14px;
  background: #ffffff;
  border: 1px solid #d1d5db;
  color: #000000 !important;
  border-radius: 8px;
  font-family: inherit;
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.2s ease;
}
#vc-lead input:focus {
  border-color: #000000;
}
#vc-lead input::placeholder {
  color: #6b7280;
}
#lsend {
  width: 100%;
  padding: 12px;
  background: #000000;
  color: #ffffff !important;
  border: none;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.2s ease;
}
#lsend:hover {
  background: #27272a;
}
#vc-row {
  display: flex;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid #e5e7eb;
  background: #ffffff;
}
#vc-in {
  flex: 1;
  font-size: 13px;
  padding: 10px 14px;
  background: #f4f4f6;
  border: 1px solid #e4e4e7;
  color: #000000 !important;
  border-radius: 8px;
  font-family: inherit;
  outline: none;
  transition: all 0.2s ease;
}
#vc-in:focus {
  background: #ffffff;
  border-color: #000000;
  box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
}
#vc-in::placeholder {
  color: #71717a;
}
#vc-send {
  width: 40px;
  height: 40px;
  background: #000000;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s ease;
}
#vc-send:hover {
  background: #27272a;
}
</style>

<script lang="ts">
const WA = '56929645522';

// ── Base de conocimiento ─────────────────────────────────────
const KB = {
  precios: {
    keys: ['precio','plan','planes','servicio','cuánto','cuanto','vale','cuesta','costo','tarifa','lista','servicios','cotizar'],
    reply: `En Vision Code estructuramos cada solución a la medida de su negocio (Venta de Servicios o Productos):\n\n• SOLUCIONES DISPONIBLES:\n  - Campañas Meta Ads (FB & IG) para captación directa de clientes\n  - Sitios Web SEO & Portales Corporativos\n  - Plataformas E-Commerce con pasarelas integradas\n  - Agentes IA WhatsApp Business 24/7\n  - Sistemas ERP de Gestión de Inventario\n\nActualmente nuestro departamento comercial elabora propuestas de cotización personalizada. Puede completar el embudo de cotización en la sección /cotizar para recomendarle el plan exacto para su empresa.`
  },
  landing: {
    keys: ['landing','página web','pagina web','sitio web','web','página','presencia','presencia digital'],
    reply: `Para desarrollo web contamos con dos alternativas principales:\n\n• Landing Page Inicial: Diseñada para captación directa de prospectos.\n• Portal Corporativo: Con secciones institucionales, blog y SEO técnico.\n\nAmbas opciones incluyen hosting y dominio. ¿Desea evaluar alguna de estas opciones para su empresa?`
  },
  ecommerce: {
    keys: ['ecommerce','e-commerce','tienda','vender','venta online','productos','shop','carrito','pasarela','pasarelas'],
    reply: `Nuestras tiendas virtuales E-Commerce se adaptan al volumen de su catálogo:\n\n• E-Commerce Básico (Hasta 20 productos)\n• E-Commerce Profesional (Catálogo ilimitado + CRO)\n• Vision Code Pro (Tienda + ERP de inventarios)\n\nTodas incluyen pasarelas de pago integradas y autogestión. ¿Cuántos productos estima comercializar?`
  },
  ia: {
    keys: ['ia','inteligencia artificial','agente','whatsapp','bot','automatizar','chatbot','respuesta automática','respuestas automáticas','asistente'],
    reply: `Automatización de atención y ventas en WhatsApp Business:\n\n• Plan Estándar: Asistente virtual 24/7 entrenado con la información de su negocio.\n• Plan Premium: Conexión a la API Oficial WhatsApp Cloud con verificación Meta Verified.\n\n¿Le gustaría recibir una demostración de atención en vivo?`
  },
  erp: {
    keys: ['erp','sistema','gestión','inventario','crm','interno','administración','control','proceso'],
    reply: `Nuestra suite Vision Code Pro integra sitio web, tienda online y software ERP interno para el control centralizado de inventario, facturación, clientes y proveedores.\n\n¿Su empresa requiere centralizar sus procesos de ventas actualmente?`
  },
  cotizar: {
    keys: ['cotizar','cotización','contratar','quiero','interesa','presupuesto','proyecto','empezar','iniciar','información'],
    reply: `Entendido. Para elaborar la propuesta técnica y cotización comercial a la medida de su empresa, por favor proporcione sus datos de contacto a continuación:`,
    action: 'lead'
  },
  saludo: {
    keys: ['hola','buenas','hey','saludos','buenos días','buenas tardes','buenas noches'],
    reply: `Estimado/a cliente, bienvenido a Vision Code.\n\nOfrecemos servicios de desarrollo web, campañas en Meta Ads, E-Commerce y Agentes de IA en WhatsApp.\n\n¿Qué solución tecnológica o publicitaria desea evaluar para su organización?`
  },
  gracias: {
    keys: ['gracias','muchas gracias','genial','perfecto','excelente','increíble'],
    reply: `Quedamos a su entera disposición. En Vision Code priorizamos la entrega de arquitecturas técnicas robustas y soluciones orientadas a la venta real.\n\n¿Existe alguna otra duda que podamos resolver en este momento?`
  },
  default: `Leído. En Vision Code nos especializamos en Campañas en Meta Ads, Desarrollo Web, E-Commerce y Agentes de Inteligencia Artificial.\n\nPara recomendarle el mejor sistema, coméntenos si su empresa comercializa Servicios o Productos.`
};

// ── Motor de intención ──────────────────────────────────────
function detect(text) {
  const t = text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  for (const [intent, data] of Object.entries(KB)) {
    if (intent === 'default') continue;
    if (data.keys && data.keys.some(k => t.includes(k.normalize('NFD').replace(/[\u0300-\u036f]/g,'')))) {
      return data;
    }
  }
  return null;
}

// ── DOM ─────────────────────────────────────────────────────
const bubble = document.getElementById('vc-bubble');
const panel  = document.getElementById('vc-panel');
const msgs   = document.getElementById('vc-msgs');
const input  = document.getElementById('vc-in');
const sendB  = document.getElementById('vc-send');
const lead   = document.getElementById('vc-lead');
const lname  = document.getElementById('lname');
const lphone = document.getElementById('lphone');
const lsend  = document.getElementById('lsend');
let started = false, busy = false, leadShown = false;

function scroll(){ msgs.scrollTop = msgs.scrollHeight; }

function addMsg(text, cls){
  const d = document.createElement('div');
  d.className = 'msg ' + cls;
  d.textContent = text;
  msgs.appendChild(d);
  scroll();
  return d;
}

function addEl(el){ msgs.appendChild(el); scroll(); }

function addWABtn(text, waText){
  const a = document.createElement('a');
  a.className = 'wa-btn';
  a.href = `https://api.whatsapp.com/send?phone=${WA}&text=${encodeURIComponent(waText)}`;
  a.target = '_blank';
  a.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.104.549 4.078 1.504 5.798L.057 23.428c-.083.334.216.633.55.55l5.63-1.447A11.951 11.951 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.807 9.807 0 01-5.003-1.37l-.358-.214-3.724.956.989-3.607-.235-.372A9.816 9.816 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>${text}`;
  addEl(a);
}

function delay(ms){ return new Promise(r => setTimeout(r, ms)); }

let history = [];

async function botReply(text, action){
  const t = document.createElement('div');
  t.className = 'msg tdots';
  t.innerHTML = '<div class="dots-wrap"><span></span><span></span><span></span></div>';
  msgs.appendChild(t); scroll();
  await delay(900);
  t.remove();
  addMsg(text, 'bot');
  if(action === 'lead' && !leadShown){
    leadShown = true;
    lead.style.display = 'flex';
  }
  busy = false;
}

async function handle(q){
  if(busy) return;
  busy = true;
  history.push({ role: 'user', content: q });

  // Show typing dots
  const t = document.createElement('div');
  t.className = 'msg tdots';
  t.innerHTML = '<div class="dots-wrap"><span></span><span></span><span></span></div>';
  msgs.appendChild(t); scroll();

  try {
    const res = await fetch('/api/constanza', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: history })
    });

    t.remove();

    if (res.ok) {
      const data = await res.json();
      const reply = data.reply;
      addMsg(reply, 'bot');
      history.push({ role: 'assistant', content: reply });

      const lowerReply = reply.toLowerCase();
      const lowerQ = q.toLowerCase();
      if (lowerQ.includes('cotizar') || lowerQ.includes('contratar') || lowerQ.includes('comprar') || lowerReply.includes('proporcione') || lowerReply.includes('datos')) {
        if (!leadShown) {
          leadShown = true;
          lead.style.display = 'flex';
        }
      }
      busy = false;
    } else {
      throw new Error('API Error');
    }
  } catch (err) {
    t.remove();
    const match = detect(q);
    const reply = match ? match.reply : KB.default;
    const action = match ? match.action : null;

    addMsg(reply, 'bot');
    history.push({ role: 'assistant', content: reply });

    if(action === 'lead' && !leadShown){
      leadShown = true;
      lead.style.display = 'flex';
    }
    busy = false;
  }
}

// Chips
document.querySelectorAll('.chip').forEach(c => {
  c.addEventListener('click', () => {
    const txt = c.querySelector('span').textContent.trim();
    addMsg(txt, 'usr');
    handle(txt);
  });
});

// Enviar mensaje
async function doSend(){
  const v = input.value.trim();
  if(!v || busy) return;
  input.value = '';
  addMsg(v, 'usr');
  await delay(100);
  handle(v);
}
sendB.addEventListener('click', doSend);
input.addEventListener('keydown', e => { if(e.key==='Enter') doSend(); });

// Lead capture
lsend.addEventListener('click', () => {
  const n = lname.value.trim();
  const p = lphone.value.trim();
  if(!n || !p){
    lname.style.borderColor = !n ? '#000000' : '#d1d5db';
    lphone.style.borderColor = !p ? '#000000' : '#d1d5db';
    return;
  }
  lead.style.display = 'none';
  addMsg(`Gracias ${n}. Le derivamos ahora con un consultor senior a través de WhatsApp para formalizar su requerimiento.`, 'bot');
  const waMsg = `Contacto Vision Code\nNombre: ${n}\nTeléfono: ${p}\nOrigen: Consulta Asesor Digital`;
  setTimeout(() => addWABtn('Iniciar comunicación por WhatsApp →', waMsg), 400);
});

// Toggle
bubble.addEventListener('click', () => {
  const open = panel.classList.toggle('open');
  document.getElementById('ico-chat').style.display = open ? 'none' : 'block';
  document.getElementById('ico-x').style.display = open ? 'block' : 'none';
  if(open && !started){
    started = true; busy = true;
    const welcome = 'Estimado/a cliente, bienvenido a la mesa de asesoría digital de Vision Code.\n\nEstamos aquí para orientar el desarrollo tecnológico de su negocio hacia la escalabilidad de sus operaciones. ¿Qué solución técnica desea evaluar hoy?';
    history.push({ role: 'assistant', content: welcome });
    botReply(welcome);
  }
});

document.getElementById('vc-close')?.addEventListener('click', () => {
  panel.classList.remove('open');
  document.getElementById('ico-chat').style.display = 'block';
  document.getElementById('ico-x').style.display = 'none';
});
</script>