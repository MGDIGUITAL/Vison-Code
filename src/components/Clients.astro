---
// Logos oficiales de grandes marcas chilenas y corporativas (Estilo Nexbu.com)
const brandLogos = [
  { name: "Mercado Libre", logo: "/images/CARUSSEL%20MARCAS/logo-mercadolibre.svg" },
  { name: "Sodimac", logo: "/images/CARUSSEL%20MARCAS/logo-sodimac.svg" },
  { name: "Casaideas", logo: "/images/CARUSSEL%20MARCAS/logo-casaideas.svg" },
  { name: "Mallplaza", logo: "/images/CARUSSEL%20MARCAS/logo-mallplaza.svg" },
  { name: "Entel", logo: "/images/CARUSSEL%20MARCAS/logo-entel.svg" },
  { name: "Falabella", logo: "/images/CARUSSEL%20MARCAS/logo-falabella.svg" },
  { name: "Copec", logo: "/images/CARUSSEL%20MARCAS/logo-copec.svg" },
  { name: "LATAM Airlines", logo: "/images/CARUSSEL%20MARCAS/logo-latam.svg" },
  { name: "Cencosud", logo: "/images/CARUSSEL%20MARCAS/logo-cencosud.svg" },
  { name: "Makita", logo: "/images/CARUSSEL%20MARCAS/logo-makita.svg" },
];
---

<section id="marcas" class="py-28 bg-black border-t border-white/10 border-b border-white/10 relative z-10 overflow-hidden text-white">
  
  <!-- Fondo de sección: 2.png ubicada en /images/fondos/2.png -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none bg-cover bg-center" style="background-image: url('/images/fondos/2.png');"></div>
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/85 via-black/70 to-black/90 pointer-events-none"></div>

  <!-- Aura de degradado ambiente radial -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(255,255,255,0.06),rgba(0,0,0,0))] pointer-events-none"></div>

  <!-- Encabezado Ejecutivo: Estilo Navbar Blanco y Negro Monocromático -->
  <div class="max-w-4xl mx-auto px-6 text-center mb-12 relative z-10">
    
    <!-- Badge Estilo Navbar -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#000000]/90 border border-white/15 text-white/90 text-[0.65rem] font-bold uppercase tracking-[0.22em] mb-5 shadow-xl backdrop-blur-xl">
      <span class="w-2 h-2 rounded-full bg-white animate-pulse shadow-[0_0_8px_rgba(255,255,255,0.8)]"></span>
      INGENIERÍA &amp; SOLUCIONES CORPORATIVAS
    </div>

    <!-- Título Principal Prestige Corporate (Montserrat/Inter) -->
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-4 drop-shadow-lg">
      Arquitectura Digital para <span class="text-white">Marcas Líderes</span>
    </h2>

    <!-- Subtítulo ejecutivo completo -->
    <p class="text-base sm:text-lg text-white/85 max-w-3xl mx-auto font-normal leading-relaxed drop-shadow">
      Construimos <strong class="text-white font-black">tecnología de alta fidelidad</strong> para empresas que buscan escala real: plataformas web y comercio electrónico, aplicaciones móviles iOS/Android, formalización legal express, automatizaciones con IA y marketing digital de alto retorno.
    </p>
  </div>

  <!-- Carrusel Estilo Nexbu.com (Píldoras Blancas de Alto Contraste) -->
  <div class="carousel-nexbu-wrap relative w-full overflow-hidden py-6 cursor-pointer">
    
    <!-- Fades de degradado laterales sin cortes -->
    <div class="absolute left-0 top-0 bottom-0 w-32 sm:w-56 bg-gradient-to-r from-black via-black/80 to-transparent z-20 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-32 sm:w-56 bg-gradient-to-l from-black via-black/80 to-transparent z-20 pointer-events-none"></div>

    <!-- Pista de animación continua marquee Nexbu -->
    <div class="marquee-track flex items-center gap-5 sm:gap-6 whitespace-nowrap">
      
      <!-- Primera Copia -->
      <div class="flex items-center gap-5 sm:gap-6 shrink-0">
        {brandLogos.map(brand => (
          <div class="nexbu-card h-16 sm:h-20 px-8 sm:px-10 rounded-2xl bg-white border border-white/20 shadow-[0_4px_25px_rgba(0,0,0,0.4)] hover:border-white hover:shadow-[0_10px_35px_rgba(255,255,255,0.2)] transition-all duration-300 flex items-center justify-center group shrink-0">
            <img
              src={brand.logo}
              alt={brand.name}
              class="max-h-8 sm:max-h-10 max-w-[130px] sm:max-w-[160px] w-auto object-contain select-none opacity-95 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Segunda Copia (Loop continuo sin cortes) -->
      <div class="flex items-center gap-5 sm:gap-6 shrink-0" aria-hidden="true">
        {brandLogos.map(brand => (
          <div class="nexbu-card h-16 sm:h-20 px-8 sm:px-10 rounded-2xl bg-white border border-white/20 shadow-[0_4px_25px_rgba(0,0,0,0.4)] hover:border-white hover:shadow-[0_10px_35px_rgba(255,255,255,0.2)] transition-all duration-300 flex items-center justify-center group shrink-0">
            <img
              src={brand.logo}
              alt={brand.name}
              class="max-h-8 sm:max-h-10 max-w-[130px] sm:max-w-[160px] w-auto object-contain select-none opacity-95 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>

    </div>
  </div>

  <!-- Encabezado de Pilares Estratégicos -->
  <div class="text-center mt-16 mb-8 relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-white text-[0.65rem] font-mono uppercase tracking-[0.25em]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      6 Pilares de Servicio &amp; Especialidad
