<style>
  /* ── Contenedor principal Nexbu: se agranda suavemente al pasar el mouse ── */
  .carousel-nexbu-wrap {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-nexbu-wrap:hover {
    transform: scale(1.03);
  }

  /* ── Pista continua gestionada dinámicamente por JS ── */
  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }
</style>

<script is:inline>
  function setupSmoothMarquee() {
    const wrap = document.querySelector('.carousel-nexbu-wrap');
    const track = document.querySelector('.marquee-track');
    if (!wrap || !track) return;

    let offset = 0;
    // Velocidad normal pausada y fluida (0.45px por frame)
    const normalSpeed = 0.45;
    // Velocidad súper lenta (efecto cámara lenta en hover)
    const slowSpeed = 0.10;
    
    let targetSpeed = normalSpeed;
    let currentSpeed = normalSpeed;

    wrap.addEventListener('mouseenter', () => {
      targetSpeed = slowSpeed;
    });

    wrap.addEventListener('mouseleave', () => {
      targetSpeed = normalSpeed;
    });

    function step() {
      // Inercia de desaceleración / aceleración suave (lerp)
      currentSpeed += (targetSpeed - currentSpeed) * 0.05;
      offset -= currentSpeed;

      const halfWidth = track.scrollWidth / 2;
      if (halfWidth > 0 && Math.abs(offset) >= halfWidth) {
        offset += halfWidth;
      }

      track.style.transform = `translate3d(${offset}px, 0, 0)`;
      requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  setupSmoothMarquee();
  document.addEventListener('astro:page-load', () => {
    setupSmoothMarquee();
  });
</script>
