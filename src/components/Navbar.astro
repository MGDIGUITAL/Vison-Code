---
const links = [
  { text: "Inicio", href: "/#inicio", id: "inicio" },
  { text: "Servicios", href: "/#servicios", id: "servicios" },
  { text: "Proyectos", href: "/proyectos", id: "impacto" },
  { text: "Clientes", href: "/#marcas", id: "marcas" },
  { text: "Cotizar", href: "/cotizar", id: "cotizar" },
];
---

<header class="fixed top-0 left-0 right-0 w-full z-50 select-none transition-all duration-300" id="navbar">
  <!-- Barra de anuncio superior — 100% De Borde a Borde -->
  <div 
    id="top-bar" 
    class="w-full bg-black py-2 px-4 sm:px-6 text-center overflow-hidden transition-all duration-300 border-b border-white/[0.08]"
  >
    <div class="max-w-7xl mx-auto flex items-center justify-center">
      <p class="text-[0.62rem] font-medium uppercase tracking-[0.25em] text-white/60 flex items-center justify-center gap-3">
        <span class="w-1.5 h-1.5 rounded-full bg-white/70 animate-pulse"></span>
        <span>Evaluación digital y consultoría técnica personalizada</span>
        <span class="hidden sm:inline w-px h-3 bg-white/20"></span>
        <a href="/cotizar" class="text-white font-bold hover:underline transition-all flex items-center gap-1">
          Cotizar Ahora &rarr;
        </a>
      </p>
    </div>
  </div>

  <!-- Barra Principal de Navegación — 100% DE BORDE A BORDE (Edge-to-Edge) -->
  <div 
    id="main-nav" 
    class="w-full bg-black/90 backdrop-blur-2xl border-b border-white/10 transition-all duration-300"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-[70px] transition-all duration-300" id="nav-inner">

      <!-- Logo con micro-glow al interactuar -->
      <a href="/#inicio" class="flex items-center group shrink-0 relative" aria-label="Vision Code - Inicio">
        <div class="absolute -inset-2 bg-white/5 rounded-xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <img
          src="/images/NAVAR TITULO.png"
          alt="VisionCode Logo"
          class="h-8 sm:h-9 w-auto object-contain transition-all duration-300 group-hover:scale-105 relative z-10"
        />
      </a>

      <!-- Desktop Links con Indicador Magnético Deslizante -->
      <nav 
        id="desktop-nav"
        class="hidden md:flex items-center gap-1 p-1 bg-white/[0.03] border border-white/10 rounded-full relative backdrop-blur-md" 
        aria-label="Navegación principal"
      >
        <!-- Pastilla indicadora animada que se desliza suavemente -->
        <span 
          id="nav-pill" 
          class="absolute h-[calc(100%-8px)] top-1 rounded-full bg-white/15 border border-white/25 shadow-[0_0_15px_rgba(255,255,255,0.12)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] pointer-events-none opacity-0"
        ></span>

        {links.map(link => (
          <a
            href={link.href}
            data-nav-id={link.id}
            class="nav-link px-4 py-1.5 rounded-full text-[0.72rem] font-bold uppercase tracking-[0.16em] text-white/70 hover:text-white transition-colors duration-200 relative z-10"
          >
            {link.text}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA & Social Actions -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Social icons -->
        <a href="https://www.instagram.com/vision_code_vc/?hl=es" target="_blank" rel="noopener noreferrer"
          class="text-white/40 hover:text-white hover:bg-white/5 transition-all duration-200 p-2 rounded-full border border-transparent hover:border-white/15"
          aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href="https://web.facebook.com/profile.php?id=61591906443953&locale=es_LA" target="_blank" rel="noopener noreferrer"
          class="text-white/40 hover:text-white hover:bg-white/5 transition-all duration-200 p-2 rounded-full border border-transparent hover:border-white/15"
          aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
          </svg>
        </a>

        <!-- Phone pill -->
        <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" rel="noopener noreferrer"
          class="hidden lg:flex items-center gap-2 text-[0.65rem] font-bold text-white/60 hover:text-white transition-all duration-200 border border-white/10 hover:border-white/30 rounded-full px-3 py-1.5 bg-white/[0.02]">
          <svg class="w-3 h-3 text-white/80" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.457L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 1.977 14.131.953 11.527.953c-5.439 0-9.859 4.373-9.864 9.803-.002 1.83.491 3.62 1.424 5.2l-.931 3.398 3.49-.917zm12.338-7.397c-.272-.136-1.61-.794-1.86-.885-.25-.091-.432-.136-.613.136-.182.271-.703.885-.862 1.066-.158.181-.317.204-.589.068-.272-.136-1.15-.424-2.19-1.352-.809-.721-1.355-1.613-1.514-1.884-.158-.271-.017-.417.119-.553.122-.122.272-.317.408-.475.136-.158.181-.271.272-.452.09-.181.045-.339-.022-.475-.068-.136-.613-1.478-.839-2.02-.22-.53-.442-.458-.607-.466-.157-.008-.339-.008-.521-.008-.181 0-.475.068-.724.339-.249.271-.95 1.04-1.04 2.533s1.085 2.937 1.233 3.14c.149.203 2.136 3.262 5.176 4.57.723.311 1.288.497 1.728.637.726.23 1.387.197 1.91.12.583-.086 1.79-.73 2.046-1.434.256-.704.256-1.31.179-1.434-.076-.124-.277-.197-.549-.333z"/>
          </svg>
          +56 9 2964 5522
        </a>

        <!-- CTA principal — Luxury White Button -->
        <a
          href="/cotizar"
          id="nav-cta"
          class="inline-flex items-center gap-2 bg-white hover:bg-neutral-200 text-black font-extrabold text-[0.68rem] uppercase tracking-[0.16em] px-5 py-2.5 rounded-full transition-all duration-300 hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:scale-[1.03] active:scale-[0.98]"
        >
          <span>Cotizar Proyecto</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="md:hidden text-white/80 hover:text-white transition-colors p-2 rounded-lg hover:bg-white/10"
        id="mobile-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer — 100% De Borde a Borde, Pure Black OLED #000000 -->
  <div
    class="md:hidden w-full bg-black/98 backdrop-blur-3xl border-b border-white/10 max-h-0 overflow-hidden transition-all duration-300 ease-in-out shadow-2xl"
    id="mobile-menu"
  >
    <div class="max-w-7xl mx-auto flex flex-col px-6 py-6 gap-2">
      {links.map(link => (
        <a
          href={link.href}
          data-nav-id={link.id}
          class="mobile-nav-link text-[0.8rem] font-bold uppercase tracking-[0.18em] text-white/80 hover:text-white hover:bg-white/10 rounded-xl px-4 py-3 transition-all duration-200 flex items-center justify-between group"
        >
          <span>{link.text}</span>
          <span class="text-white/30 group-hover:text-white group-hover:translate-x-1 transition-all text-xs">&rarr;</span>
        </a>
      ))}
      <div class="h-px bg-white/10 my-3"></div>
      <div class="flex flex-col gap-2.5 text-[0.72rem] text-white/60 px-4">
        <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" rel="noopener noreferrer"
          class="hover:text-white transition-colors flex items-center gap-2.5">
          <svg class="w-3.5 h-3.5 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>+56 9 2964 5522</span>
        </a>
        <a href="mailto:Vision.code.vs@gmail.com"
          class="hover:text-white transition-colors flex items-center gap-2.5">
          <svg class="w-3.5 h-3.5 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Vision.code.vs@gmail.com</span>
        </a>
      </div>
      <a
        href="/cotizar"
        class="mt-3 text-center text-[0.72rem] font-extrabold uppercase tracking-widest text-black bg-white hover:bg-neutral-200 px-5 py-3.5 rounded-full transition-all duration-200 shadow-[0_0_20px_rgba(255,255,255,0.25)]"
      >
        Cotizar Proyecto &rarr;
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  mobileBtn?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpen = mobileMenu.style.maxHeight && mobileMenu.style.maxHeight !== '0px';
    if (isOpen) {
      mobileMenu.style.maxHeight = '0px';
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
    }
  });

  mobileMenu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.style.maxHeight = '0px';
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  // Solid Edge-to-Edge Sticky Navbar Logic on Scroll (Stable Height — No Vertical Shift)
  const topBar = document.getElementById('top-bar');
  const mainNav = document.getElementById('main-nav');

  function handleNavbarScroll() {
    const y = window.scrollY;
    if (y > 20) {
      if (topBar) {
        topBar.style.maxHeight = '0px';
        topBar.style.opacity = '0';
        topBar.style.borderBottomWidth = '0px';
      }
      if (mainNav) {
        mainNav.classList.remove('bg-black/90');
        mainNav.classList.add(
          'bg-black/98',
          'border-b',
          'border-white/15',
          'shadow-[0_12px_40px_rgba(0,0,0,0.9)]'
        );
      }
    } else {
      if (topBar) {
        topBar.style.maxHeight = '42px';
        topBar.style.opacity = '1';
        topBar.style.borderBottomWidth = '1px';
      }
      if (mainNav) {
        mainNav.classList.remove(
          'bg-black/98',
          'border-white/15',
          'shadow-[0_12px_40px_rgba(0,0,0,0.9)]'
        );
        mainNav.classList.add('bg-black/90');
      }
    }
  }

  window.addEventListener('scroll', handleNavbarScroll, { passive: true });
  handleNavbarScroll();

  // Magnetic Sliding Pill Indicator & Glitch-Free Navigation
  const desktopNav = document.getElementById('desktop-nav');
  const navPill = document.getElementById('nav-pill');
  const navLinks = document.querySelectorAll('#desktop-nav .nav-link');
  const navCta = document.getElementById('nav-cta');

  let isClickScrolling = false;
  let scrollLockTimeout = null;
  let spyLastId = null;
  let pillPlaced = false;

  function movePillTo(element) {
    if (!navPill || !desktopNav || !element) return;
    const navRect = desktopNav.getBoundingClientRect();
    const linkRect = element.getBoundingClientRect();

    // Absolute children are positioned from the padding box, so subtract the border.
    const left = linkRect.left - navRect.left - desktopNav.clientLeft;
    const width = linkRect.width;

    // First placement must not animate (otherwise the pill sweeps in from x=0).
    if (!pillPlaced) navPill.style.transition = 'none';

    navPill.style.left = `${left}px`;
    navPill.style.width = `${width}px`;
    navPill.style.opacity = '1';

    if (!pillPlaced) {
      void navPill.offsetWidth; // flush styles before re-enabling the transition
      navPill.style.transition = '';
      pillPlaced = true;
    }
  }

  function setActiveLink(link) {
    navLinks.forEach(l => {
      l.classList.remove('active', 'text-white');
      l.classList.add('text-white/70');
    });
    if (link) {
      link.classList.add('active', 'text-white');
      link.classList.remove('text-white/70');
      movePillTo(link);
    }
  }

  function hidePillIfNoActive() {
    const activeLink = document.querySelector('#desktop-nav .nav-link.active');
    if (activeLink) {
      movePillTo(activeLink);
    } else if (navPill) {
      navPill.style.opacity = '0';
    }
  }

  // Hover preview
  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => movePillTo(link));
  });

  desktopNav?.addEventListener('mouseleave', () => {
    hidePillIfNoActive();
  });

  let lockTargetLink = null;
  let scrollLockHardCap = null;

  function releaseScrollLock() {
    if (!isClickScrolling) return;
    isClickScrolling = false;
    clearTimeout(scrollLockTimeout);
    clearTimeout(scrollLockHardCap);
    window.removeEventListener('scroll', onLockScroll);
    window.removeEventListener('wheel', releaseScrollLock);
    window.removeEventListener('touchstart', releaseScrollLock);
    const active = document.querySelector('#desktop-nav .nav-link.active') || lockTargetLink;
    if (active) movePillTo(active);
  }

  // Every scroll event while locked postpones the release until scrolling goes idle
  function onLockScroll() {
    clearTimeout(scrollLockTimeout);
    scrollLockTimeout = setTimeout(releaseScrollLock, 160);
  }

  function scrollToSection(targetId) {
    const targetElement = document.getElementById(targetId);
    if (!targetElement) return false;

    // 1. Lock ScrollSpy so the pill does not twitch or jump across intermediate sections
    isClickScrolling = true;
    spyLastId = targetId;
    lockTargetLink = document.querySelector(`#desktop-nav .nav-link[data-nav-id="${targetId}"]`);
    clearTimeout(scrollLockTimeout);
    clearTimeout(scrollLockHardCap);
    window.removeEventListener('scroll', onLockScroll);
    window.removeEventListener('wheel', releaseScrollLock);
    window.removeEventListener('touchstart', releaseScrollLock);
    window.addEventListener('scroll', onLockScroll, { passive: true });
    window.addEventListener('wheel', releaseScrollLock, { passive: true, once: true });
    window.addEventListener('touchstart', releaseScrollLock, { passive: true, once: true });

    // 2. Immediately highlight and glide pill to the target link
    const targetLink = document.querySelector(`#desktop-nav .nav-link[data-nav-id="${targetId}"]`);
    navLinks.forEach(l => {
      l.classList.remove('active', 'text-white');
      l.classList.add('text-white/70');
    });

    if (targetLink) {
      targetLink.classList.add('active', 'text-white');
      targetLink.classList.remove('text-white/70');
      movePillTo(targetLink);
    }

    // 3. Precise smooth scroll destination accounting for fixed header height
    const headerOffset = 76;
    const elementTop = targetElement.getBoundingClientRect().top + window.pageYOffset;
    const finalScrollY = Math.max(0, elementTop - headerOffset);

    window.scrollTo({
      top: finalScrollY,
      behavior: 'smooth'
    });

    // 4. Release the lock only once the smooth scroll has really stopped
    scrollLockTimeout = setTimeout(releaseScrollLock, 300);   // covers "already at target"
    scrollLockHardCap = setTimeout(releaseScrollLock, 5000);  // safety net

    return true;
  }

  // Intercept desktop nav link clicks on home page anchors
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href') || '';
      const isAnchor = href.startsWith('/#') || href.startsWith('#');
      const isHomePage = window.location.pathname === '/' || window.location.pathname === '';

      if (isAnchor && isHomePage) {
        const hash = href.substring(href.indexOf('#') + 1);
        if (scrollToSection(hash)) {
          e.preventDefault();
          history.pushState(null, '', `#${hash}`);
        }
      }
    });
  });


  // Mobile nav links
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href') || '';
      const isAnchor = href.startsWith('/#') || href.startsWith('#');
      const isHomePage = window.location.pathname === '/' || window.location.pathname === '';

      if (isAnchor && isHomePage) {
        const hash = href.substring(href.indexOf('#') + 1);
        if (scrollToSection(hash)) {
          e.preventDefault();
          history.pushState(null, '', `#${hash}`);
        }
      }
    });
  });

  // Scroll-position ScrollSpy: one deterministic active section (no observer flicker)
  function initScrollSpy() {
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
    if (!isHomePage) return;

    const ids = ['inicio', 'servicios', 'marcas', 'impacto'];
    const els = ids.map(id => document.getElementById(id)).filter(Boolean);
    if (!els.length) return;

    let ticking = false;

    function update() {
      ticking = false;
      if (isClickScrolling) return;

      const line = window.innerHeight * 0.35;
      let current = els[0].id;
      for (const el of els) {
        if (el.getBoundingClientRect().top <= line) current = el.id;
      }
      if (current === spyLastId) return;
      spyLastId = current;

      const link = document.querySelector(`#desktop-nav .nav-link[data-nav-id="${current}"]`);
      if (link) setActiveLink(link);
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    update();
  }

  // Initial active link based on current route
  function setInitialActive() {
    const path = window.location.pathname;
    const hash = window.location.hash;
    let target = null;

    if (path === '/proyectos') target = document.querySelector('#desktop-nav .nav-link[href="/proyectos"]');
    else if (path === '/cotizar') target = document.querySelector('#desktop-nav .nav-link[href="/cotizar"]');
    else if (path === '/' || path === '') {
      const id = hash ? hash.substring(1) : 'inicio';
      target = document.querySelector(`#desktop-nav .nav-link[data-nav-id="${id}"]`)
            || document.querySelector('#desktop-nav .nav-link[data-nav-id="inicio"]');
    }

    if (target) setActiveLink(target);
  }

  window.addEventListener('resize', () => {
    hidePillIfNoActive();
  }, { passive: true });

  // Re-measure once web fonts / images settle so the pill never drifts
  window.addEventListener('load', hidePillIfNoActive);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(hidePillIfNoActive);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setInitialActive();
      initScrollSpy();
    });
  } else {
    setInitialActive();
    initScrollSpy();
  }
</script>

<style>
  #top-bar {
    transition: max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    max-height: 42px;
    overflow: hidden;
  }

  #nav-pill {
    transition: left 0.28s cubic-bezier(0.16, 1, 0.3, 1), width 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    will-change: left, width;
  }

  .nav-link.active {
    color: #ffffff !important;
  }
</style>
